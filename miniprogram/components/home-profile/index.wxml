<view class="home-profile">
  <view class="home-profile__gradient" />
  <image class="home-profile__stripes" src="/assets/line-bg.svg" mode="scaleToFill" />
  <navigation-bar class="home-profile__navigation" back="{{false}}" title="" color="#000000" background="transparent" />
  <view wx:if="{{profile}}" class="home-profile__content">
    <view class="home-profile__identity">
      <image class="home-profile__avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <text class="home-profile__nickname">{{profile.nickname}}</text>
      <view
        class="home-profile__settings"
        bindtap="onSettingsTap"
        hover-class="home-profile__settings--pressed"
        hover-stay-time="80"
      >
        <text>设置</text>
      </view>
    </view>

    <view
      class="home-profile__membership {{membershipCardClass}}"
      bindtap="onMembershipTap"
      hover-class="home-profile__membership--pressed"
      hover-stay-time="80"
    >
      <block wx:if="{{showPremiumCard}}">
        <image class="home-profile__membership-premium-background" src="/assets/profile/membership-premium-background.svg" mode="scaleToFill" aria-hidden="true" />
        <view class="home-profile__membership-premium-copy">
          <view class="home-profile__membership-premium-header">
            <text class="home-profile__membership-premium-title">尊享会员</text>
            <text class="home-profile__membership-premium-expire">{{profile.membership.expireLabel}} 到期</text>
          </view>
          <text class="home-profile__membership-premium-subtitle">你是尊贵的尊享会员，享无限追踪人数</text>
          <view class="home-profile__membership-premium-renew">
            <text>续费</text>
          </view>
        </view>
      </block>
      <block wx:elif="{{showStandardCard}}">
        <image class="home-profile__membership-active-background" src="/assets/profile/membership-standard-background.svg" mode="scaleToFill" aria-hidden="true" />
        <view class="home-profile__membership-active-copy">
          <view class="home-profile__membership-active-header">
            <text class="home-profile__membership-active-title">标准会员</text>
            <text class="home-profile__membership-active-expire">{{profile.membership.expireLabel}} 到期</text>
          </view>
          <view class="home-profile__membership-active-upgrade">
            <text>升级尊享会员，畅享无限人数追踪</text>
            <image class="home-profile__membership-active-arrow" src="/assets/profile/membership-inactive-arrow.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <view class="home-profile__membership-active-tracking">
            <view class="home-profile__membership-active-tracking-label">
              <text>剩余追踪人数</text>
              <text>{{profile.membership.trackingLabel}}</text>
            </view>
            <view class="home-profile__membership-active-progress">
              <view
                wx:for="{{profile.membership.trackingSegments}}"
                wx:key="id"
                class="home-profile__membership-active-segment {{item.active ? 'home-profile__membership-active-segment--active' : ''}}"
              />
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="home-profile__membership-inactive">
          <image class="home-profile__membership-inactive-background" src="/assets/profile/membership-inactive-background.svg" mode="scaleToFill" aria-hidden="true" />
          <image class="home-profile__membership-inactive-rings" src="/assets/profile/membership-inactive-rings.svg" mode="scaleToFill" aria-hidden="true" />
          <image class="home-profile__membership-inactive-border" src="/assets/profile/membership-inactive-border.svg" mode="scaleToFill" aria-hidden="true" />
          <view class="home-profile__membership-inactive-copy">
            <image class="home-profile__membership-inactive-crown" src="/assets/profile/membership-inactive-crown.png" mode="aspectFit" aria-hidden="true" />
            <view class="home-profile__membership-inactive-text">
              <text class="home-profile__membership-inactive-title">解锁言界阿乐会员</text>
              <text class="home-profile__membership-inactive-subtitle">专属分析功能，不漏掉任何潜在用户</text>
            </view>
            <view class="home-profile__membership-inactive-action">
              <text>开通会员</text>
              <image class="home-profile__membership-inactive-arrow" src="/assets/profile/membership-inactive-arrow.svg" mode="aspectFit" aria-hidden="true" />
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="home-profile__feature-mask {{featureMaskClass}}" aria-hidden="true" />

    <view class="home-profile__features" aria-label="会员功能列表">
      <view class="home-profile__feature">
        <view class="home-profile__feature-leading">
          <image class="home-profile__feature-icon" src="/assets/profile/profile-list-wallet.svg" mode="aspectFit" />
          <text>钱包中心</text>
        </view>
        <image class="home-profile__feature-arrow" src="/assets/profile/profile-list-arrow.svg" mode="aspectFit" />
      </view>
      <view class="home-profile__feature">
        <view class="home-profile__feature-leading">
          <image class="home-profile__feature-icon" src="/assets/profile/profile-list-collect.svg" mode="aspectFit" />
          <text>我的收藏</text>
        </view>
        <image class="home-profile__feature-arrow" src="/assets/profile/profile-list-arrow.svg" mode="aspectFit" />
      </view>
      <view class="home-profile__feature">
        <view class="home-profile__feature-leading">
          <image class="home-profile__feature-icon" src="/assets/profile/profile-list-other.svg" mode="aspectFit" />
          <text>我的收藏</text>
        </view>
        <image class="home-profile__feature-arrow" src="/assets/profile/profile-list-arrow.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="home-profile__pending" data-node-id="902:12850">
      <view class="home-profile__pending-button"><text>{{profile.pendingTitle}}</text></view>
      <text class="home-profile__pending-description">{{profile.pendingDescription}}</text>
    </view>
  </view>
  <loading-skeleton wx:else variant="detail" />
</view>
