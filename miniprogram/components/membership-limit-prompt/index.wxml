<view class="membership-limit-prompt membership-limit-prompt--{{variant}}" bindtap="onUpgradeTap" hover-class="membership-limit-prompt--pressed" hover-start-time="80" hover-stay-time="120">
  <block wx:if="{{variant === 'visitor'}}">
    <view class="membership-limit-prompt__visitor-content">
      <view class="membership-limit-prompt__visitor-copy">
        <text class="membership-limit-prompt__visitor-message">又有 <text class="membership-limit-prompt__visitor-count">{{visitorCount}}</text> 个用户查看了你作品</text>
        <text class="membership-limit-prompt__visitor-description">升级会员，查看详情</text>
      </view>
      <view class="membership-limit-prompt__visitor-avatars">
        <view wx:for="{{visitorAvatars}}" wx:for-item="avatar" wx:key="id" class="membership-limit-prompt__visitor-avatar-wrap">
          <image class="membership-limit-prompt__visitor-avatar {{avatar.shouldBlur ? 'membership-limit-prompt__visitor-avatar--blurred' : ''}}" src="{{avatar.url}}" mode="aspectFill" />
        </view>
      </view>
    </view>
  </block>
  <block wx:else>
    <image class="membership-limit-prompt__background" src="/assets/home-new/membership-limit-background.svg" mode="scaleToFill" />
    <image class="membership-limit-prompt__rings" src="/assets/home-new/membership-limit-rings.svg" mode="scaleToFill" />
    <view class="membership-limit-prompt__content">
      <image class="membership-limit-prompt__crown" src="/assets/profile/membership-card-crown.svg" mode="aspectFit" />
      <view class="membership-limit-prompt__copy">
        <text class="membership-limit-prompt__message">追踪已达上限，开通/升级会员触达更多客户</text>
        <view class="membership-limit-prompt__upgrade"><text>{{actionLabel}}</text></view>
      </view>
    </view>
  </block>
</view>
