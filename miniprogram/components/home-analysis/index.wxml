<view class="analysis-page {{embedded ? 'analysis-page--embedded' : ''}}">
  <view wx:if="{{!embedded}}" class="analysis-page__header">
    <navigation-bar title="分析" back="{{false}}" color="#000000" background="#ffffff" />
    <view wx:if="{{analysisData}}" class="analysis-tabs" bindtouchstart="onAnalysisTouchStart" bindtouchend="onAnalysisTouchEnd">
      <view class="analysis-tabs__selection" style="transform: translateX({{analysisTabOffset}}%);"></view>
      <view wx:for="{{analysisTabs}}" wx:key="id" class="analysis-tabs__item {{item.id === activeAnalysisTab ? 'analysis-tabs__item--active' : ''}}" bindtap="onAnalysisTabTap" data-index="{{index}}">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{analysisData && activeAnalysisTab === 'work'}}" class="analysis-page__content analysis-page__content--work">
    <view class="analysis-work-panel analysis-work-panel--redesign">
      <view class="analysis-summary analysis-summary--redesign">
        <view wx:for="{{workSummary}}" wx:key="label" class="analysis-summary__card"><text class="analysis-summary__label">{{item.label}}</text><text class="analysis-summary__value">{{item.value}}</text></view>
      </view>
      <view wx:if="{{hasAnalysisCards}}" class="analysis-work-list">
        <view class="analysis-filters analysis-filters--redesign home-analysis__filters">
          <segmented-filter items="{{analysisPeriods}}" active-id="{{activePeriod}}" item-width="68" bind:change="onPeriodTap" />
          <view class="analysis-sort" bindtap="onAnalysisSortTap"><view class="analysis-sort__inner"><text>{{activeAnalysisSortLabel}}</text><image class="analysis-sort__arrow" src="/assets/analysis/polygon-2.svg" mode="aspectFit" /></view></view>
        </view>
        <view class="analysis-work-list__inner">
          <block wx:for="{{visibleAnalysisCards}}" wx:key="id">
            <view class="analysis-work-row" hover-class="analysis-card--pressed" hover-stay-time="120" bindtap="onCardTap" data-id="{{item.id}}">
              <view class="analysis-work-row__head">
                <image class="analysis-work-row__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" />
                <view class="analysis-work-row__identity"><text class="analysis-work-row__title">{{item.title}}</text><text class="analysis-work-row__date">{{item.publishedAt}}</text></view>
              </view>
              <view class="analysis-work-row__metrics"><view wx:for="{{item.compactMetrics}}" wx:key="label" class="analysis-work-row__metric"><text class="analysis-work-row__metric-label">{{item.label}}</text><text class="analysis-work-row__metric-value">{{item.value}}</text></view></view>
            </view>
            <view wx:if="{{index < visibleAnalysisCards.length - 1}}" class="analysis-work-row__divider"></view>
          </block>
        </view>
      </view>
      <view wx:else class="analysis-empty-state analysis-empty-state--work">
        <image class="analysis-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
        <text>还没有作品，你可以发布一个</text>
      </view>
    </view>
  </view>

  <view wx:if="{{analysisData && activeAnalysisTab === 'user'}}" class="analysis-page__content">
    <view class="analysis-user-panel">
      <view class="analysis-user__summary">
        <view wx:for="{{analysisData.userSummary}}" wx:key="label" class="analysis-user__summary-card"><text class="analysis-user__summary-label">{{item.label}}</text><text class="analysis-user__summary-value">{{item.value}}</text></view>
      </view>
      <text class="analysis-user__title">意向用户</text>
      <view wx:if="{{hasAnalysisUsers}}" class="analysis-user__list-panel">
        <view class="analysis-filters analysis-filters--redesign home-analysis__filters">
          <segmented-filter items="{{analysisPeriods}}" active-id="{{activePeriod}}" item-width="68" bind:change="onPeriodTap" />
          <view class="analysis-sort" bindtap="onAnalysisSortTap"><view class="analysis-sort__inner"><text>{{activeAnalysisSortLabel}}</text><image class="analysis-sort__arrow" src="/assets/analysis/polygon-2.svg" mode="aspectFit" /></view></view>
        </view>
        <view class="analysis-user__list">
          <view wx:for="{{visibleAnalysisUsers}}" wx:key="id" class="analysis-user" bindtap="onAnalysisUserTap" data-id="{{item.id}}" hover-class="analysis-user--pressed">
            <image class="analysis-user__avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view class="analysis-user__body">
              <view class="analysis-user__summary-line">
                <view class="analysis-user__identity"><text class="analysis-user__name">{{item.name}}</text><text class="analysis-user__tag analysis-user__tag--{{item.level}}">#{{item.levelLabel}}</text></view>
                <view class="analysis-user__stats"><view class="analysis-user__stat"><text class="analysis-user__stat-label">浏览次数</text><text class="analysis-user__stat-value">{{item.readCount}}</text></view><view class="analysis-user__stat-divider"></view><view class="analysis-user__stat"><text class="analysis-user__stat-label">完播</text><text class="analysis-user__stat-value">{{item.completionCount}}</text></view><view class="analysis-user__stat-divider"></view><view class="analysis-user__stat"><text class="analysis-user__stat-label">转发</text><text class="analysis-user__stat-value">{{item.shareCount}}</text></view></view>
              </view>
              <view class="analysis-user__line"></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="analysis-empty-state analysis-empty-state--user">
        <image class="analysis-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
        <text>还没用户，快去发布作品吧</text>
      </view>
    </view>
  </view>

  <view wx:if="{{analysisData && activeAnalysisTab === 'total'}}" class="analysis-page__content">
    <segmented-filter wx:if="{{!embedded}}" items="{{totalAnalysisPeriods}}" active-id="{{activeTotalPeriod}}" bind:change="onTotalPeriodTap" />
    <view class="analysis-total-panel">
      <view class="analysis-total__overview-card">
        <text class="analysis-total__title">数据总览</text>
        <view class="analysis-total__hero-metrics">
          <view wx:for="{{analysisData.totalData.heroMetrics}}" wx:key="label" class="analysis-total__hero-metric {{index === 0 ? '' : 'analysis-total__hero-metric--secondary'}}">
            <text class="analysis-total__hero-value">{{item.value}}</text>
            <view class="analysis-total__hero-meta"><text>{{item.label}}</text><image class="analysis-total__hero-divider" src="/assets/analysis/total-metric-divider.svg" mode="aspectFit" /><view class="analysis-total__hero-comparison"><text>较昨日</text><text class="analysis-total__hero-delta">{{item.delta}}</text></view></view>
          </view>
        </view>
        <view class="analysis-total__overview-grid">
          <view wx:for="{{analysisData.totalData.overview}}" wx:key="label" class="analysis-total__overview-item"><text class="analysis-total__overview-label">{{item.label}}</text><text class="analysis-total__overview-value">{{item.value}}</text></view>
        </view>
      </view>
      <view class="analysis-total__chart-card">
        <text class="analysis-total__title">浏览峰值</text>
        <view class="analysis-total__chart {{activeAnalysisReadRange === 'month' ? 'analysis-total__chart--month' : ''}}">
          <view class="analysis-total__chart-gridline analysis-total__chart-gridline--top"><text>1500</text></view>
          <view class="analysis-total__chart-gridline analysis-total__chart-gridline--upper"><text>1000</text></view>
          <view class="analysis-total__chart-gridline analysis-total__chart-gridline--lower"><text>500</text></view>
          <view class="analysis-total__chart-gridline analysis-total__chart-gridline--bottom"><text>0</text></view>
          <view class="analysis-total__chart-bars"><view wx:for="{{visibleAnalysisReadTrend}}" wx:key="id" class="analysis-total__chart-point"><view class="analysis-total__chart-bar" style="height: {{item.height}}rpx;"></view><text class="analysis-total__chart-label">{{item.label}}</text></view></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{analysisSortSheetVisible && !embedded}}" class="analysis-sort-sheet">
    <view class="analysis-sort-sheet__mask" catchtap="onAnalysisSortMaskTap"></view>
    <view class="analysis-sort-sheet__panel">
      <view wx:for="{{analysisSortOptions}}" wx:key="id" class="analysis-sort-sheet__option" bindtap="onAnalysisSortOptionTap" data-id="{{item.id}}">{{item.label}}</view>
    </view>
  </view>
  <view wx:if="{{!analysisData}}" class="home-tab-loading">正在加载分析</view>
</view>
