<view class="notification-page notification-page--embedded">
  <view wx:if="{{notifications}}" class="notification-page__content">
    <view wx:if="{{hasVisibleGroups}}">
      <view wx:for="{{visibleGroups}}" wx:key="id" class="notification-group">
        <text class="notification-group__date">{{item.label}}</text>
        <view class="notification-group__cards">
        <view
          wx:for="{{item.items}}"
          wx:for-item="notification"
          wx:key="id"
          class="home-notification-card"
          data-id="id:{{notification.userId}}"
          data-event-id="{{notification.eventId}}"
          bindtap="onNotificationCardTap"
          hover-class="home-card--pressed"
          hover-start-time="80"
          hover-stay-time="120"
        >
          <view wx:if="{{notification.isUnread}}" class="home-notification-card__unread-dot" />
          <view class="home-notification-card__main">
            <view class="home-notification-card__identity">
              <view class="home-avatar-wrap">
                <image class="home-avatar" src="{{notification.avatarUrl}}" mode="aspectFill" />
                <image class="home-action-icon" src="{{notification.actionIconPath}}" mode="aspectFit" />
              </view>
              <view class="home-notification-card__copy">
                <view class="home-notification-card__name-row">
                  <text class="home-notification-card__name">{{notification.visitorName}}</text>
                  <text class="home-intent-tag home-intent-tag--{{notification.intent}}">{{notification.intentLabel}}</text>
                </view>
                <view class="home-notification-card__action-row">
                  <text class="home-notification-card__action">{{notification.actionLabel}}</text>
                  <text class="home-notification-card__date">{{notification.actionDate}}</text>
                </view>
                <text class="home-status-tag home-status-tag--{{notification.intent}}">{{notification.statusLabel}}</text>
              </view>
            </view>
            <image class="home-notification-card__thumbnail" src="{{notification.thumbnailUrl}}" mode="aspectFill" />
          </view>
        </view>
        </view>
      </view>
    </view>

    <view wx:else class="notification-empty-state">
      <image class="notification-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
      <text>暂无意向用户</text>
    </view>
  </view>
  <view wx:else class="notification-page__loading">正在加载通知</view>
</view>
