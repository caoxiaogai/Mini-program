<view wx:if="{{active}}" class="single-page-guard single-page-guard--active" capture-catch:tap="onBlockedTap">
  <slot />
  <cover-view class="single-page-guard__mask" catchtap="onBlockedTap" catchtouchmove="onBlockedMove"></cover-view>
</view>
<view wx:else class="single-page-guard">
  <slot />
</view>
