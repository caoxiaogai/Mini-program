<view
  wx:if="{{visible}}"
  class="publish-type-sheet"
  aria-role="dialog"
  aria-label="{{dialogLabel}}"
>
  <view class="publish-type-sheet__mask" catchtap="onMaskTap"></view>
  <view class="publish-type-sheet__panel">
    <view wx:if="{{kind === 'entry'}}" class="publish-type-sheet__hint">
      <text>若选择原图，创建耗时相对较长</text>
    </view>
    <view
      wx:for="{{options}}"
      wx:key="id"
      class="publish-type-sheet__option"
      data-id="{{item.id}}"
      bindtap="onOptionTap"
      hover-class="publish-type-sheet__option--pressed"
      hover-stay-time="80"
    >
      <text>{{item.label}}</text>
    </view>
  </view>
</view>
