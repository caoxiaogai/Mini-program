<view class="analysis-page__header {{embedded ? 'analysis-page__header--embedded' : ''}} {{navigationHeight > 0 ? 'analysis-page__header--measured' : ''}}" style="--analysis-navigation-height: {{navigationHeight}}px;">
  <navigation-bar title="{{title}}" title-weight="{{titleWeight}}" back="{{back}}" color="#000000" background="transparent" />
  <view wx:if="{{analysisTabs.length}}" class="analysis-page__filter">
    <segmented-filter items="{{analysisTabs}}" active-id="{{activeAnalysisTab}}" variant="notification" bind:change="onAnalysisTabTap" bind:touchstart="onAnalysisTouchStart" bind:touchend="onAnalysisTouchEnd" />
  </view>
</view>
