<view wx:if="{{visible}}" class="upload-loading" catchtouchmove="preventMove" aria-role="alert" aria-label="{{text}}">
  <view class="upload-loading__mask" />
  <view class="upload-loading__panel">
    <view class="upload-loading__spinner" />
    <text class="upload-loading__text">{{text}}</text>
  </view>
</view>
