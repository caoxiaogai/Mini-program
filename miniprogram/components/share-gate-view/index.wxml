<view class="share-gate-page" bindtap="onPageTap">
  <view class="share-gate-page__hero {{artFromWork || !artSrc ? 'share-gate-page__hero--work' : ''}}">
    <navigation-bar title="" back="{{false}}" color="#000000" background="transparent" />
    <image wx:if="{{artFromWork}}" class="share-gate-page__work-cover" src="{{artSrc}}" mode="aspectFill" />
    <image wx:elif="{{artSrc}}" class="share-gate-page__art" src="{{artSrc}}" mode="aspectFill" />
  </view>

  <view class="share-gate-page__content">
    <text class="share-gate-page__hint">点击查看更多 访问完整内容</text>
    <view class="share-gate-page__social-proof">
      <view class="share-gate-page__avatars">
        <image wx:for="{{friendAvatars}}" wx:key="*this" class="share-gate-page__avatar" src="{{item}}" mode="aspectFill" />
      </view>
      <text class="share-gate-page__likes">以上好友赞了该内容</text>
    </view>
    <view class="share-gate-page__primary-wrap"><button class="share-gate-page__primary" catchtap="onMoreTap" hover-class="share-gate-page__primary--pressed">查看更多</button></view>
  </view>
</view>
