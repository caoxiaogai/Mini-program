<view class="home-page" style="--analysis-navigation-height: {{analysisNavigationHeight}}px; --notification-navigation-height: {{analysisNavigationHeight}}px;">
  <view class="home-page__tabs">
    <view class="home-page__tab-panel" hidden="{{activeTabIndex !== 0}}">
      <image class="home-page__header-background" src="/assets/home-new/home-header-background.svg" mode="scaleToFill" style="opacity: {{homeHeaderGradientOpacity}}" />
      <scroll-view scroll-y class="home-page__tab-scroll" bindscroll="onHomeScroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh">
        <navigation-bar back="{{false}}" title="首页" color="rgba(0,0,0, {{homeHeaderOpacity}})" background="rgba(255,255,255, {{homeHeaderOpacity}})" />
        <view class="home-page__content">
          <view class="home-hero">
            <view class="home-hero__copy">
              <view class="home-hero__line home-hero__headline-row"><text class="home-hero__headline">“{{greetingHeadline}}”</text><image class="home-hero__headline-icon" src="/assets/home-new/home-greeting-flame.png" mode="aspectFit" /></view>
              <view class="home-hero__line home-hero__subtitle-row"><text class="home-hero__subtitle">{{greetingSubtitle}}</text><image class="home-hero__subtitle-icon" src="/assets/home-new/home-greeting-star.png" mode="aspectFit" /></view>
            </view>
          </view>
          <view wx:if="{{isLoading}}" class="home-state home-state--loading"><text>正在加载首页数据</text></view>
          <view wx:elif="{{loadError}}" class="home-state"><text class="home-state__title">首页数据暂时不可用</text><text class="home-state__description">请检查网络后重试</text><button class="home-state__retry" bindtap="onRetryTap">重新加载</button></view>
          <block wx:else>
            <view class="home-membership-limit"><membership-limit-prompt bind:upgrade="onHomeMembershipLimitTap" /></view>
            <view class="home-section home-section--notifications">
              <view class="home-section__header">
                <view class="home-section__title-row"><text class="home-section__title">互动消息</text><text wx:if="{{homeData.unreadNotificationCount}}" class="home-section__badge">{{homeData.unreadNotificationCount}}</text></view>
                <notification-mark-all-read wx:if="{{homeData.unreadNotificationCount}}" compact="{{true}}" unread-count="{{homeData.unreadNotificationCount}}" collapse-key="{{homeNotificationMarkAllReadCollapseKey}}" bind:markallread="onHomeMarkAllReadTap" />
              </view>
              <view wx:if="{{homeData.notifications.length}}" class="home-notification-list">
                <view wx:for="{{homeData.notifications}}" wx:key="id" wx:if="{{index < 5}}" class="home-notification-card-stack {{homeData.unreadNotificationCount > 3 && index === 2 ? 'home-notification-card-stack--with-more' : ''}} {{index === 3 ? 'home-notification-card-stack--overflow home-notification-card-stack--overflow-first' : index === 4 ? 'home-notification-card-stack--overflow home-notification-card-stack--overflow-second' : ''}}">
                  <view class="home-notification-card" data-id="{{item.id}}" data-user-id="id:{{item.userId}}" bindtap="onNotificationTap" hover-class="home-card--pressed">
                    <view class="home-notification-card__main">
                      <view class="home-notification-card__identity">
                        <view class="home-avatar-wrap"><image wx:if="{{item.avatarUrl}}" class="home-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="home-avatar home-avatar--empty" /><image class="home-action-icon" src="{{item.actionIconPath}}" mode="aspectFit" /></view>
                        <view class="home-notification-card__copy">
                          <view class="home-notification-card__name-row"><text class="home-notification-card__name">{{item.visitorName}}</text><text class="home-intent-tag home-intent-tag--{{item.intent}}">{{item.intentLabel}}</text></view>
                          <view class="home-notification-card__action-row"><text class="home-notification-card__action">{{item.actionLabel}}</text><text class="home-notification-card__date">{{item.actionDate}}</text></view>
                          <text class="home-status-tag home-status-tag--{{item.intent}}">{{item.statusLabel}}</text>
                        </view>
                      </view>
                      <image wx:if="{{item.thumbnailUrl}}" class="home-notification-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-notification-card__thumbnail home-notification-card__thumbnail--empty" />
                    </view>
                    <view wx:if="{{homeData.unreadNotificationCount > 3 && index === 2}}" class="home-notification-card__more-button" catchtap="onTabTap" data-id="notifications" hover-class="home-card--pressed"><text>查看更多</text></view>
                  </view>
                </view>
              </view>
              <view wx:else class="home-empty home-empty--notification home-notification-empty-card"><image class="home-notification-empty-card__cloud" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" /><text class="home-notification-empty-card__message">暂时还没有人浏览你的作品</text></view>
            </view>
            <view class="home-section home-section--ranking"><view class="home-ranking-entry" bindtap="onRankingEntryTap" hover-class="home-card--pressed"><image class="home-ranking-entry__glow" src="/assets/ranking/ranking-bottom-glow.svg" mode="scaleToFill" /><image class="home-ranking-entry__texture" src="/assets/ranking/ranking-texture.svg" mode="scaleToFill" /><view class="home-ranking-entry__copy"><image class="home-ranking-entry__title" src="/assets/ranking/ranking-title.png" mode="aspectFit" /><text class="home-ranking-entry__subtitle">看看谁的内容更受欢迎</text><view class="home-ranking-entry__button"><text>查看详情</text></view></view><image class="home-ranking-entry__trophy" src="/assets/ranking/ranking-trophy.png" mode="aspectFit" /></view></view>
            <view class="home-section home-section--today-most">
              <view class="home-content-card">
                <view class="home-today-most__header" bindtap="onTodayMostTap" hover-class="home-card--pressed">
                  <view class="home-section__title-row"><image class="home-today-most__icon" src="/assets/home-new/today-most-icon.svg" mode="aspectFit" /><text class="home-section__title">今日浏览最多</text></view>
                  <image class="home-today-most__chevron" src="/assets/home-new/today-most-chevron.svg" mode="aspectFit" />
                </view>
                <view wx:if="{{homeData.contents.length}}" class="home-content-list">
                  <block wx:for="{{homeData.contents}}" wx:key="id">
                    <view class="home-content-card__item" bindtap="onTodayMostTap" hover-class="home-card--pressed">
                      <view class="home-content-card__top">
                        <image wx:if="{{item.thumbnailUrl}}" class="home-content-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-content-card__thumbnail home-content-card__thumbnail--empty" />
                        <view class="home-content-card__copy"><text class="home-content-card__title">{{item.title}}</text><text class="home-content-card__date">{{item.date}}</text><text class="home-content-card__intent home-content-card__intent--{{item.highIntentLevel}}">{{item.highIntentLabel}}</text></view>
                      </view>
                      <view class="home-content-card__stats"><view class="home-stat"><text>浏览次数</text><text class="home-stat__value">{{item.viewCount}}</text></view><view class="home-stat"><text>转发</text><text class="home-stat__value">{{item.forwardCount}}</text></view><view class="home-stat"><text>完播</text><text class="home-stat__value">{{item.completeCount}}</text></view></view>
                    </view>
                  </block>
                </view>
                <view wx:else class="home-content-card__empty"><image class="home-empty__cloud" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" /><text class="home-empty__message">还没有作品，你可以发布一个</text><view class="home-empty-publish" bindtap="onPlusTap" hover-class="home-empty-publish--pressed"><text>立即发布</text><text class="home-empty-publish__plus">+</text></view></view>
                <view class="home-today-most__more-button" bindtap="onTodayMostTap" hover-class="home-card--pressed"><text>查看更多</text></view>
              </view>
            </view>
            <view class="home-section">
              <view class="home-intent-card" bindtap="onIntentSummaryTap" hover-class="home-card--pressed">
                <image class="home-intent-card__background" src="/assets/home-new/intent-card-background.svg" mode="scaleToFill" />
                <view class="home-intent-card__content">
                  <view class="home-intent-card__headline-row">
                    <image class="home-intent-card__icon" src="/assets/home-new/intent-summary-user-icon.svg" mode="aspectFit" />
                    <text class="home-intent-card__headline">今日新增 <text class="home-accent">{{homeData.intentSummary.total}}</text> 个客户</text>
                  </view>
                  <view class="home-intent-card__metrics">
                    <view class="home-intent-metric home-intent-metric--high">
                      <image class="home-intent-metric__icon" src="/assets/home-new/intent-high-icon.svg" mode="aspectFit" />
                      <view class="home-intent-metric__copy"><text class="home-intent-metric__value">+{{homeData.intentSummary.highCount}}</text><text class="home-intent-metric__label">高意向</text></view>
                    </view>
                    <view class="home-intent-metric home-intent-metric--medium">
                      <view class="home-intent-metric__middle-icon"><view class="home-intent-metric__middle-line" /></view>
                      <view class="home-intent-metric__copy"><text class="home-intent-metric__value">+{{homeData.intentSummary.mediumCount}}</text><text class="home-intent-metric__label">中意向</text></view>
                    </view>
                    <view class="home-intent-metric home-intent-metric--low">
                      <image class="home-intent-metric__icon" src="/assets/home-new/intent-low-icon.svg" mode="aspectFit" />
                      <view class="home-intent-metric__copy"><text class="home-intent-metric__value">+{{homeData.intentSummary.lowCount}}</text><text class="home-intent-metric__label">低意向</text></view>
                    </view>
                  </view>
                  <view class="home-intent-card__more"><text>查看更多</text></view>
                </view>
              </view>
            </view>
            <view class="home-section">
              <view class="home-today-card" bindtap="onTodayDataTap" hover-class="home-card--pressed">
                <image class="home-today-card__background" src="/assets/home-new/today-data-background-926.svg" mode="scaleToFill" />
                <view class="home-today-card__header">
                  <view class="home-today-card__title">
                    <image class="home-today-card__icon" src="/assets/home-new/today-data-date-icon.svg" mode="aspectFit" />
                    <text class="home-today-card__title-label">今日数据</text>
                  </view>
                </view>
                <view class="home-today-card__divider" aria-hidden="true" />
                <view class="home-today-card__body">
                  <view class="home-today-card__hero">
                    <view class="home-today-card__hero-primary">
                      <text class="home-today-card__number">{{homeData.today.viewCount}}次</text>
                      <text class="home-today-card__label">浏览次数</text>
                    </view>
                    <view class="home-today-card__hero-divider"></view>
                    <view class="home-today-card__hero-primary home-today-card__hero-primary--viewer">
                      <text class="home-today-card__number">{{homeData.today.viewerCount}}人</text>
                      <text class="home-today-card__label">阅读人数</text>
                    </view>
                  </view>
                  <view class="home-today-card__metrics">
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.completeCount}}</text><text>总完播</text></view>
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.forwardCount}}</text><text>转发次数</text></view>
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.viewerCount}}</text><text>观看人数</text></view>
                  </view>
                  <view class="home-today-card__metrics home-today-card__intent-metrics">
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.highCount}}</text><text>高意向</text></view>
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.mediumCount}}</text><text>中意向</text></view>
                    <view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.lowCount}}</text><text>低意向</text></view>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
    <view class="home-page__tab-panel home-page__notification-panel" hidden="{{activeTabIndex !== 1}}"><notification-header embedded="{{true}}" navigation-height="{{analysisNavigationHeight}}" filters="{{notifications.filters}}" active-filter="{{activeNotificationFilter}}" bind:filtertap="onNotificationFilterTap" /><scroll-view scroll-y class="home-page__tab-scroll home-page__notification-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh" lower-threshold="120" bindscrolltolower="onNotificationsScrollToLower"><home-notifications notifications="{{notifications}}" active-filter="{{activeNotificationFilter}}" visible-groups="{{visibleNotificationGroups}}" has-visible-groups="{{hasVisibleNotificationGroups}}" bind:cardtap="onNotificationCardTap" bind:contactaction="onNotificationContactAction" bind:upgrade="onHomeMembershipLimitTap" /></scroll-view></view>
    <view class="home-page__tab-panel home-page__materials-panel" hidden="{{activeTabIndex !== 2}}">
      <view class="materials-page {{isAndroid ? 'materials-page--android' : ''}}" style="--materials-navigation-height: {{analysisNavigationHeight}}px;">
        <view class="materials-page__top">
          <view class="materials-page__gradient" />
          <image class="materials-page__stripes" src="/assets/line-bg.svg" mode="scaleToFill" />
          <view class="materials-page__header">
          <navigation-bar back="{{false}}" title="素材" color="#000000" background="transparent" />
          <view wx:if="{{materials}}" class="materials-filter" role="tablist">
            <view
              wx:for="{{materials.filters}}"
              wx:key="id"
              class="materials-filter__item {{activeMaterialFilter === item.id ? 'materials-filter__item--active' : ''}}"
              bindtap="onMaterialFilterTap"
              data-id="{{item.id}}"
              hover-class="materials-filter__item--pressed"
              hover-stay-time="80"
              role="tab"
              aria-selected="{{activeMaterialFilter === item.id}}"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
          </view>
        </view>
        <scroll-view scroll-y class="home-page__tab-scroll home-page__materials-scroll" show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh" lower-threshold="120" bindscrolltolower="onMaterialsScrollToLower">
          <view wx:if="{{materials}}" class="materials-page__content">
            <view wx:if="{{hasVisibleMaterials}}" class="materials-grid">
              <view
                wx:for="{{visibleMaterials}}"
                wx:key="id"
                class="materials-card"
                bindtap="onMaterialCardTap"
                data-id="{{item.id}}"
                hover-class="materials-card--pressed"
                hover-start-time="80"
                hover-stay-time="120"
              >
                <view class="materials-card__preview">
                  <image class="materials-card__image" src="{{item.thumbnailUrl}}" mode="aspectFill" />
                  <view wx:if="{{item.isDraft}}" class="materials-card__draft">草稿</view>
                  <image wx:if="{{item.kind === 'video'}}" class="materials-card__play" src="/assets/materials/material-play.svg" mode="aspectFit" />
                </view>
                <view class="materials-card__info">
                  <text class="materials-card__title">{{item.title}}</text>
                  <text class="materials-card__date">{{item.date}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="materials-empty-state">
              <image class="materials-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
              <text>还没有素材，发布一个吧</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="materials-publish-bar">
        <view class="materials-publish-button" bindtap="onMaterialPublishTap" hover-class="materials-publish-button--pressed" hover-stay-time="80">
          <text>发布素材</text>
          <image src="/assets/materials/material-plus.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="home-page__tab-panel home-page__analysis-panel" hidden="{{activeTabIndex !== 3}}">
      <analysis-header embedded="{{true}}" navigation-height="{{analysisNavigationHeight}}" analysis-tabs="{{analysisTabs}}" active-analysis-tab="{{activeAnalysisTab}}" analysis-tab-offset="{{analysisTabOffset}}" bind:analysistabtap="onAnalysisTabTap" bind:analysistouchstart="onAnalysisTouchStart" bind:analysistouchend="onAnalysisTouchEnd" />
      <scroll-view scroll-y class="home-page__tab-scroll home-page__analysis-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh" lower-threshold="120" bindscrolltolower="onAnalysisScrollToLower">
        <home-analysis embedded="{{true}}" analysis-data="{{analysisData}}" active-analysis-tab="{{activeAnalysisTab}}" analysis-periods="{{analysisPeriods}}" active-period="{{activePeriod}}" active-analysis-sort-label="{{activeAnalysisSortLabel}}" analysis-sort-options="{{analysisSortOptions}}" analysis-sort-sheet-visible="{{analysisSortSheetVisible}}" visible-analysis-users="{{visibleAnalysisUsers}}" work-summary="{{workSummary}}" work-count="{{workCount}}" visible-analysis-cards="{{visibleAnalysisCards}}" has-analysis-cards="{{hasAnalysisCards}}" has-analysis-users="{{hasAnalysisUsers}}" total-analysis-periods="{{totalAnalysisPeriods}}" active-overview-period="{{activeOverviewPeriod}}" active-peak-period="{{activePeakPeriod}}" active-analysis-read-range="{{activeAnalysisReadRange}}" visible-analysis-read-trend="{{visibleAnalysisReadTrend}}" analysis-trend-slot-count="{{analysisTrendSlotCount}}" chart-axis-ticks="{{chartAxisTicks}}" chart-axis-max="{{chartAxisMax}}" chart-axis-scale="{{chartAxisScale}}" bind:periodtap="onAnalysisPeriodTap" bind:overviewperiodtap="onTotalOverviewPeriodTap" bind:peakperiodtap="onTotalPeakPeriodTap" bind:analysissorttap="onAnalysisSortTap" bind:analysissortoptiontap="onAnalysisSortOptionTap" bind:analysissortmasktap="onAnalysisSortMaskTap" bind:cardtap="onAnalysisCardTap" bind:usertap="onAnalysisUserTap" />
      </scroll-view>
    </view>
    <view class="home-page__tab-panel home-page__profile-panel" hidden="{{activeTabIndex !== 4}}"><scroll-view scroll-y class="home-page__tab-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh"><home-profile profile="{{profileData}}" bind:settingstap="onProfileSettingsTap" bind:membershiptap="onProfileMembershipTap" /></scroll-view></view>
  </view>
  <view wx:if="{{analysisSortSheetVisible}}" class="analysis-sort-sheet">
    <view class="analysis-sort-sheet__mask" catchtap="onAnalysisSortMaskTap"></view>
    <view class="analysis-sort-sheet__panel">
      <view wx:for="{{analysisSortOptions}}" wx:key="id" class="analysis-sort-sheet__option" bindtap="onHomeAnalysisSortOptionTap" data-id="{{item.id}}">{{item.label}}</view>
    </view>
  </view>
  <date-range-picker visible="{{dateRangePickerVisible}}" start-date="{{datePickerStartDate}}" end-date="{{datePickerEndDate}}" min-date="{{twoMonthsAgoDate}}" max-date="{{todayDate}}" bind:confirm="onDateRangeConfirm" bind:cancel="onDateRangeCancel" />
  <notification-mark-all-read wx:if="{{activeTabIndex === 1 && unreadNotificationCount}}" unread-count="{{unreadNotificationCount}}" bind:markallread="onMarkAllReadTap" />
  <bottom-tab-bar wx:if="{{!analysisSortSheetVisible}}" items="{{tabItems}}" plus-active="{{plusActive}}" bind:tabtap="onTabTap" bind:plus="onPlusTap" />
  <publish-type-sheet visible="{{publishTypeSheetVisible}}" bind:select="onPublishTypeSelect" bind:cancel="onPublishTypeCancel" />
  <publish-type-sheet kind="source" visible="{{publishSourceSheetVisible}}" bind:select="onPublishSourceSelect" bind:cancel="onPublishSourceCancel" />
  <publish-success-modal
    visible="{{showPublishSuccessModal}}"
    share-ready="{{shareImageUrl ? true : false}}"
    share-image-url="{{shareImageUrl}}"
    bind:close="onPublishSuccessClose"
    bind:sharemoments="onShareMomentsTap"
  />
</view>
