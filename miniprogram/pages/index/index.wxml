<view class="home-page">
  <view class="home-page__tabs">
    <view class="home-page__tab-panel" hidden="{{activeTabIndex !== 0}}">
      <scroll-view scroll-y class="home-page__tab-scroll" bindscroll="onHomeScroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh">
        <view class="home-page__hero-background" />
        <navigation-bar back="{{false}}" title="首页" color="rgba(0,0,0, {{homeHeaderOpacity}})" background="rgba(255,255,255, {{homeHeaderOpacity}})" />
        <view class="home-page__content">
          <view class="home-hero">
            <image class="home-hero__glow" src="/assets/home-new/home-hero-glow.svg" mode="aspectFit" />
            <view class="home-hero__copy"><text class="home-hero__headline">{{greetingHeadline}}</text><text class="home-hero__subtitle">{{greetingSubtitle}}</text></view>
          </view>
          <view wx:if="{{isLoading}}" class="home-state home-state--loading"><text>正在加载首页数据</text></view>
          <view wx:elif="{{loadError}}" class="home-state"><text class="home-state__title">首页数据暂时不可用</text><text class="home-state__description">请检查网络后重试</text><button class="home-state__retry" bindtap="onRetryTap">重新加载</button></view>
          <block wx:else>
            <view class="home-section home-section--notifications"><view class="home-section__header"><view class="home-section__title-row"><text class="home-section__title">互动消息</text><text wx:if="{{homeData.unreadNotificationCount}}" class="home-section__badge">{{homeData.unreadNotificationCount}}</text></view><text class="home-section__more" bindtap="onTabTap" data-id="notifications">查看更多</text></view><view wx:if="{{homeData.notifications.length}}" class="home-notification-list"><view wx:for="{{homeData.notifications}}" wx:key="id" class="home-notification-card" data-id="{{item.id}}" data-user-id="id:{{item.userId}}" bindtap="onNotificationTap" hover-class="home-card--pressed"><view class="home-notification-card__main"><view class="home-notification-card__identity"><view class="home-avatar-wrap"><image wx:if="{{item.avatarUrl}}" class="home-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="home-avatar home-avatar--empty" /><image class="home-action-icon" src="{{item.actionIconPath}}" mode="aspectFit" /></view><view class="home-notification-card__copy"><view class="home-notification-card__name-row"><text class="home-notification-card__name">{{item.visitorName}}</text><text class="home-intent-tag home-intent-tag--{{item.intent}}">{{item.intentLabel}}</text></view><view class="home-notification-card__action-row"><text class="home-notification-card__action">{{item.actionLabel}}</text><text class="home-notification-card__date">{{item.actionDate}}</text></view></view></view><image wx:if="{{item.thumbnailUrl}}" class="home-notification-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-notification-card__thumbnail home-notification-card__thumbnail--empty" /></view><text class="home-status-tag home-status-tag--{{item.intent}}">{{item.statusLabel}}</text></view></view><view wx:else class="home-empty home-empty--notification home-notification-empty-card"><image class="home-notification-empty-card__cloud" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" /><text class="home-notification-empty-card__message">暂时还没有人浏览你的作品</text></view></view>
            <view class="home-section home-section--ranking"><view class="home-section__header"><text class="home-section__title">排行榜</text></view><view class="home-ranking-entry" bindtap="onRankingEntryTap" hover-class="home-card--pressed"><view class="home-ranking-entry__copy"><image class="home-ranking-entry__title" src="/assets/ranking/ranking-title.png" mode="aspectFit" /><text class="home-ranking-entry__subtitle">看看谁的内容更受欢迎</text></view><image class="home-ranking-entry__trophy" src="/assets/ranking/ranking-trophy.png" mode="aspectFit" /></view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">今日浏览最多</text><text class="home-section__more" bindtap="onTodayMostTap">查看更多</text></view><view wx:if="{{homeData.contents.length}}" class="home-content-list"><view class="home-content-card"><block wx:for="{{homeData.contents}}" wx:key="id"><view class="home-content-card__item" bindtap="onTodayMostTap" hover-class="home-card--pressed"><view class="home-content-card__top"><image wx:if="{{item.thumbnailUrl}}" class="home-content-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-content-card__thumbnail home-content-card__thumbnail--empty" /><view class="home-content-card__copy"><text class="home-content-card__title">{{item.title}}</text><text class="home-content-card__date">{{item.date}}</text></view></view><view class="home-content-card__stats"><view class="home-stat"><text>浏览次数</text><text class="home-stat__value">+{{item.viewCount}}</text></view><view class="home-stat"><text>转发</text><text class="home-stat__value">+{{item.forwardCount}}</text></view><view class="home-stat"><text>高意向</text><text class="home-stat__value">+{{item.highIntentCount}}</text></view></view></view><view wx:if="{{index < homeData.contents.length - 1}}" class="home-content-card__divider" /></block></view></view><view wx:else class="home-content-card home-content-card--empty"><image class="home-empty__cloud" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" /><text class="home-empty__message">还没有作品，你可以发布一个</text><view class="home-empty-publish" bindtap="onPlusTap" hover-class="home-empty-publish--pressed"><text>立即发布</text><text class="home-empty-publish__plus">+</text></view></view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">意向用户</text></view><view class="home-intent-card" bindtap="onIntentSummaryTap" hover-class="home-card--pressed"><view class="home-intent-card__top"><text wx:if="{{hasNewIntentUsers}}" class="home-intent-card__headline">今日新增 <text class="home-accent">{{homeData.intentSummary.total}}</text> 个客户</text><text wx:else class="home-intent-card__headline">今日有个新增用户</text><view wx:if="{{homeData.intentSummary.previewAvatars.length}}" class="home-intent-card__avatars"><image wx:for="{{homeData.intentSummary.previewAvatars}}" wx:key="id" wx:if="{{item.avatarUrl}}" class="home-intent-card__avatar" src="{{item.avatarUrl}}" mode="aspectFill" /></view></view><view class="home-intent-card__metrics"><view class="home-intent-metric"><text>高意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.highCount}}</text></view><view class="home-intent-metric"><text>中意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.mediumCount}}</text></view><view class="home-intent-metric"><text>低意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.lowCount}}</text></view></view></view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">今日数据</text></view><view class="home-today-card" bindtap="onTodayDataTap" hover-class="home-card--pressed"><view class="home-today-card__primary"><text class="home-today-card__number">{{homeData.today.viewCount}}次</text><view class="home-today-card__metadata"><text class="home-today-card__label">浏览总次数</text><image wx:if="{{homeData.today.comparison}}" class="home-today-card__comparison-divider" src="/assets/analysis/total-metric-divider.svg" mode="aspectFit" /><view wx:if="{{homeData.today.comparison}}" class="home-today-card__comparison"><text>{{homeData.today.comparison.label}}</text><text class="home-today-card__comparison-value">{{homeData.today.comparison.value}}</text></view></view></view><view class="home-today-card__metrics"><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.completeCount}}</text><text>完播数</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.forwardCount}}</text><text>转发次数</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.viewerCount}}</text><text>观看人数</text></view></view><view class="home-today-card__metrics home-today-card__intent-metrics"><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.highCount}}</text><text>高意向</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.mediumCount}}</text><text>中意向</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.intentSummary.lowCount}}</text><text>低意向</text></view></view></view></view>
          </block>
        </view>
      </scroll-view>
    </view>
    <view class="home-page__tab-panel home-page__notification-panel" hidden="{{activeTabIndex !== 1}}"><notification-header embedded="{{true}}" filters="{{notifications.filters}}" active-filter="{{activeNotificationFilter}}" bind:filtertap="onNotificationFilterTap" /><scroll-view scroll-y class="home-page__tab-scroll home-page__notification-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh"><home-notifications notifications="{{notifications}}" active-filter="{{activeNotificationFilter}}" visible-groups="{{visibleNotificationGroups}}" has-visible-groups="{{hasVisibleNotificationGroups}}" bind:cardtap="onNotificationCardTap" bind:contactaction="onNotificationContactAction" /></scroll-view></view>
    <view class="home-page__tab-panel home-page__materials-panel" hidden="{{activeTabIndex !== 2}}">
      <view class="materials-page {{isAndroid ? 'materials-page--android' : ''}}">
        <view class="materials-page__base"></view>
        <image class="materials-page__status-glow" src="/assets/materials/materials-stripes.svg" mode="scaleToFill" />
        <view class="materials-page__header" style="background: rgba(255, 255, 255, {{materialsHeaderOpacity}});">
          <navigation-bar back="{{false}}" title="素材" color="#000000" background="transparent" />
        </view>
        <view wx:if="{{materials}}" class="materials-filter" role="tablist">
          <view
            wx:for="{{materials.filters}}"
            wx:key="id"
            class="materials-filter__item {{activeMaterialFilter === item.id ? 'materials-filter__item--active' : ''}}"
            bindtap="onMaterialFilterTap"
            data-id="{{item.id}}"
            hover-class="materials-filter__item--pressed"
            hover-stay-time="80"
            role="tab"
            aria-selected="{{activeMaterialFilter === item.id}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
        <scroll-view scroll-y class="home-page__tab-scroll home-page__materials-scroll" bindscroll="onMaterialsScroll" show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh">
          <view wx:if="{{materials}}" class="materials-page__content">
            <view wx:if="{{hasVisibleMaterials}}" class="materials-grid">
              <view
                wx:for="{{visibleMaterials}}"
                wx:key="id"
                class="materials-card"
                bindtap="onMaterialCardTap"
                data-id="{{item.id}}"
                hover-class="materials-card--pressed"
                hover-start-time="80"
                hover-stay-time="120"
              >
                <view class="materials-card__preview">
                  <image class="materials-card__image" src="{{item.thumbnailUrl}}" mode="aspectFill" />
                  <view wx:if="{{item.isDraft}}" class="materials-card__draft">草稿</view>
                  <image wx:if="{{item.kind === 'video'}}" class="materials-card__play" src="/assets/materials/material-play.svg" mode="aspectFit" />
                </view>
                <view class="materials-card__info">
                  <text class="materials-card__title">{{item.title}}</text>
                  <text class="materials-card__date">{{item.date}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="materials-empty-state">
              <image class="materials-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
              <text>还没有素材，发布一个吧</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="materials-publish-bar">
        <view class="materials-publish-button" bindtap="onMaterialPublishTap" hover-class="materials-publish-button--pressed" hover-stay-time="80">
          <text>发布素材</text>
          <image src="/assets/materials/material-plus.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="home-page__tab-panel home-page__analysis-panel" hidden="{{activeTabIndex !== 3}}">
      <analysis-header embedded="{{true}}" analysis-tabs="{{analysisTabs}}" active-analysis-tab="{{activeAnalysisTab}}" analysis-tab-offset="{{analysisTabOffset}}" bind:analysistabtap="onAnalysisTabTap" bind:analysistouchstart="onAnalysisTouchStart" bind:analysistouchend="onAnalysisTouchEnd" />
      <view wx:if="{{analysisData && activeAnalysisTab === 'total'}}" class="home-page__analysis-total-filter">
        <segmented-filter items="{{totalAnalysisPeriods}}" active-id="{{activeTotalPeriod}}" bind:change="onTotalAnalysisPeriodTap" />
      </view>
      <scroll-view scroll-y class="home-page__tab-scroll home-page__analysis-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh">
        <home-analysis embedded="{{true}}" analysis-data="{{analysisData}}" active-analysis-tab="{{activeAnalysisTab}}" analysis-periods="{{analysisPeriods}}" active-period="{{activePeriod}}" active-analysis-sort-label="{{activeAnalysisSortLabel}}" analysis-sort-options="{{analysisSortOptions}}" analysis-sort-sheet-visible="{{analysisSortSheetVisible}}" visible-analysis-users="{{visibleAnalysisUsers}}" work-summary="{{workSummary}}" visible-analysis-cards="{{visibleAnalysisCards}}" has-analysis-cards="{{hasAnalysisCards}}" has-analysis-users="{{hasAnalysisUsers}}" total-analysis-periods="{{totalAnalysisPeriods}}" active-total-period="{{activeTotalPeriod}}" active-analysis-read-range="{{activeAnalysisReadRange}}" visible-analysis-read-trend="{{visibleAnalysisReadTrend}}" analysis-trend-slot-count="{{analysisTrendSlotCount}}" chart-axis-ticks="{{chartAxisTicks}}" chart-axis-max="{{chartAxisMax}}" chart-axis-scale="{{chartAxisScale}}" bind:periodtap="onAnalysisPeriodTap" bind:totalperiodtap="onTotalAnalysisPeriodTap" bind:analysissorttap="onAnalysisSortTap" bind:analysissortoptiontap="onAnalysisSortOptionTap" bind:analysissortmasktap="onAnalysisSortMaskTap" bind:cardtap="onAnalysisCardTap" bind:usertap="onAnalysisUserTap" />
      </scroll-view>
    </view>
    <view class="home-page__tab-panel home-page__profile-panel" hidden="{{activeTabIndex !== 4}}"><scroll-view scroll-y class="home-page__tab-scroll" refresher-enabled="{{true}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullRefresh"><home-profile profile="{{profileData}}" bind:settingstap="onProfileSettingsTap" /></scroll-view></view>
  </view>
  <view wx:if="{{analysisSortSheetVisible}}" class="analysis-sort-sheet">
    <view class="analysis-sort-sheet__mask" catchtap="onAnalysisSortMaskTap"></view>
    <view class="analysis-sort-sheet__panel">
      <view wx:for="{{analysisSortOptions}}" wx:key="id" class="analysis-sort-sheet__option" bindtap="onHomeAnalysisSortOptionTap" data-id="{{item.id}}">{{item.label}}</view>
    </view>
  </view>
  <date-range-picker visible="{{dateRangePickerVisible}}" start-date="{{customStartDate}}" end-date="{{customEndDate}}" min-date="{{twoMonthsAgoDate}}" max-date="{{todayDate}}" bind:confirm="onDateRangeConfirm" bind:cancel="onDateRangeCancel" />
  <bottom-tab-bar wx:if="{{!analysisSortSheetVisible}}" items="{{tabItems}}" plus-active="{{plusActive}}" bind:tabtap="onTabTap" bind:plus="onPlusTap" />
  <publish-success-modal
    visible="{{showPublishSuccessModal}}"
    bind:close="onPublishSuccessClose"
    bind:sharemoments="onShareMomentsTap"
  />
</view>
