<view class="home-page">
  <navigation-bar back="{{false}}" color="#000000" background="transparent">
    <text slot="left" class="home-page__title">阿宝AI</text>
  </navigation-bar>

  <view wx:if="{{homeData}}" class="home-page__main">
    <view class="home-assistant">
      <view class="home-assistant__image-frame">
        <image class="home-assistant__image" src="/assets/home/ai-assistant.png" mode="aspectFit" />
      </view>
      <text class="home-assistant__greeting">{{greeting}}</text>
    </view>

    <view class="home-summary">
      <view class="home-summary__card home-summary__card--visitors" bindtap="onSummaryCardTap" data-analysis-tab="user" hover-class="home-summary__card--pressed" hover-start-time="80" hover-stay-time="120">
        <view class="home-summary__copy">
          <text class="home-summary__primary">{{homeSummary.newVisitors.primaryPrefix}}<text wx:if="{{homeSummary.newVisitors.primaryValue}}" class="home-summary__number">{{homeSummary.newVisitors.primaryValue}}</text>{{homeSummary.newVisitors.primarySuffix}}</text>
          <text class="home-summary__secondary {{homeSummary.newVisitors.isEmpty ? 'home-summary__secondary--empty' : ''}}">{{homeSummary.newVisitors.secondaryPrefix}}<text wx:if="{{homeSummary.newVisitors.secondaryValue}}" class="home-summary__secondary-strong">{{homeSummary.newVisitors.secondaryValue}}</text>{{homeSummary.newVisitors.secondarySuffix}}</text>
        </view>
        <view wx:if="{{homeSummary.newVisitors.showVisitors}}" class="home-summary__avatars">
          <image
            wx:for="{{homeSummary.newVisitors.visitors}}"
            wx:key="id"
            class="home-summary__avatar {{index === 0 ? 'home-summary__avatar--first' : ''}}"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
        </view>
      </view>

      <view class="home-summary__card home-summary__card--compact" bindtap="onSummaryCardTap" data-analysis-tab="work" hover-class="home-summary__card--pressed" hover-start-time="80" hover-stay-time="120">
        <text class="home-summary__primary">{{homeSummary.reading.primaryPrefix}}<text wx:if="{{homeSummary.reading.primaryValue}}" class="home-summary__number">{{homeSummary.reading.primaryValue}}</text>{{homeSummary.reading.primarySuffix}}</text>
        <text class="home-summary__secondary {{homeSummary.reading.isEmpty ? 'home-summary__secondary--empty' : ''}}">{{homeSummary.reading.secondaryPrefix}}<text wx:if="{{homeSummary.reading.secondaryValue}}" class="home-summary__secondary-strong">{{homeSummary.reading.secondaryValue}}</text>{{homeSummary.reading.secondarySuffix}}</text>
      </view>

      <view class="home-summary__card home-summary__card--compact" bindtap="onSummaryCardTap" data-analysis-tab="work" hover-class="home-summary__card--pressed" hover-start-time="80" hover-stay-time="120">
        <text class="home-summary__primary">{{homeSummary.sharing.primaryPrefix}}<text wx:if="{{homeSummary.sharing.primaryValue}}" class="home-summary__number">{{homeSummary.sharing.primaryValue}}</text>{{homeSummary.sharing.primarySuffix}}</text>
        <text class="home-summary__secondary {{homeSummary.sharing.isEmpty ? 'home-summary__secondary--empty' : 'home-summary__secondary--ellipsis'}}">{{homeSummary.sharing.secondaryPrefix}}<text wx:if="{{homeSummary.sharing.secondaryValue}}" class="home-summary__secondary-strong">{{homeSummary.sharing.secondaryValue}}</text>{{homeSummary.sharing.secondarySuffix}}</text>
      </view>
    </view>
  </view>

  <bottom-tab-bar items="{{tabItems}}" bind:tabtap="onTabTap" />
</view>
