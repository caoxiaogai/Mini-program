<view class="home-page">
  <swiper class="home-page__tabs" current="{{activeTabIndex}}" duration="0" bindchange="onTabChange">
    <swiper-item class="home-page__tab-panel">
      <scroll-view scroll-y class="home-page__tab-scroll" bindscroll="onHomeScroll">
        <view class="home-page__hero-background" />
        <navigation-bar back="{{false}}" title="首页" color="rgba(0,0,0, {{homeHeaderOpacity}})" background="rgba(255,255,255, {{homeHeaderOpacity}})" />
        <view class="home-page__content">
          <view class="home-hero"><view class="home-hero__copy"><text class="home-hero__headline">{{greetingHeadline}}</text><text class="home-hero__subtitle">{{greetingSubtitle}}</text></view><view class="home-hero__image-frame"><image class="home-hero__image" src="/assets/home-new/hero-lounge.png" mode="scaleToFill" /></view></view>
          <view wx:if="{{isLoading}}" class="home-state home-state--loading"><text>正在加载首页数据</text></view>
          <view wx:elif="{{loadError}}" class="home-state"><text class="home-state__title">首页数据暂时不可用</text><text class="home-state__description">请检查网络后重试</text><button class="home-state__retry" bindtap="onRetryTap">重新加载</button></view>
          <block wx:else>
            <view class="home-section home-section--notifications"><view class="home-section__header"><view class="home-section__title-row"><text class="home-section__title">实时通知</text><text wx:if="{{homeData.unreadNotificationCount}}" class="home-section__badge">{{homeData.unreadNotificationCount}}</text></view><text class="home-section__more" bindtap="onTabTap" data-id="notifications">查看更多</text></view><view wx:if="{{homeData.notifications.length}}" class="home-notification-list"><view wx:for="{{homeData.notifications}}" wx:key="id" class="home-notification-card" data-user-id="{{item.userId}}" bindtap="onNotificationTap" hover-class="home-card--pressed"><view class="home-notification-card__main"><view class="home-notification-card__identity"><view class="home-avatar-wrap"><image wx:if="{{item.avatarUrl}}" class="home-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="home-avatar home-avatar--empty" /><image class="home-action-icon" src="{{item.actionIconPath}}" mode="aspectFit" /></view><view class="home-notification-card__copy"><view class="home-notification-card__name-row"><text class="home-notification-card__name">{{item.visitorName}}</text><text class="home-intent-tag home-intent-tag--{{item.intent}}">{{item.intentLabel}}</text></view><view class="home-notification-card__action-row"><text class="home-notification-card__action">{{item.actionLabel}}</text><text class="home-notification-card__date">{{item.actionDate}}</text></view></view></view><image wx:if="{{item.thumbnailUrl}}" class="home-notification-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-notification-card__thumbnail home-notification-card__thumbnail--empty" /></view><text class="home-status-tag home-status-tag--{{item.intent}}">{{item.statusLabel}}</text></view></view><view wx:else class="home-empty">今天还没有新的客户动态</view></view>
            <view class="home-section home-section--ranking"><view class="home-section__header"><text class="home-section__title">排行榜</text></view><view class="home-ranking-entry" bindtap="onRankingEntryTap" hover-class="home-card--pressed"><view class="home-ranking-entry__copy"><image class="home-ranking-entry__title" src="/assets/ranking/ranking-title.png" mode="aspectFit" /><text class="home-ranking-entry__subtitle">看看谁的内容更受欢迎</text></view><image class="home-ranking-entry__trophy" src="/assets/ranking/ranking-trophy.png" mode="aspectFit" /></view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">今日最多</text><text class="home-section__more" bindtap="onTabTap" data-id="analysis">查看更多</text></view><view wx:if="{{homeData.contents.length}}" class="home-content-list"><view class="home-content-card"><block wx:for="{{homeData.contents}}" wx:key="id"><view class="home-content-card__item" data-id="{{item.id}}" bindtap="onContentTap" hover-class="home-card--pressed"><view class="home-content-card__top"><image wx:if="{{item.thumbnailUrl}}" class="home-content-card__thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" /><view wx:else class="home-content-card__thumbnail home-content-card__thumbnail--empty" /><view class="home-content-card__copy"><text class="home-content-card__title">{{item.title}}</text><text class="home-content-card__date">{{item.date}}</text></view></view><view class="home-content-card__stats"><view class="home-stat"><text>阅读</text><text class="home-stat__value">+{{item.viewCount}}</text></view><view class="home-stat"><text>转发</text><text class="home-stat__value">+{{item.forwardCount}}</text></view><view class="home-stat"><text>高意向</text><text class="home-stat__value">+{{item.highIntentCount}}</text></view></view></view><view wx:if="{{index < homeData.contents.length - 1}}" class="home-content-card__divider" /></block></view></view><view wx:else class="home-empty">今天还没有发布内容</view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">意向用户</text></view><view class="home-intent-card"><view class="home-intent-card__top"><text class="home-intent-card__headline">今日有 <text class="home-accent">{{homeData.intentSummary.total}}</text> 个新增用户</text><view wx:if="{{homeData.intentSummary.previewAvatars.length}}" class="home-intent-card__avatars"><image wx:for="{{homeData.intentSummary.previewAvatars}}" wx:key="id" wx:if="{{item.avatarUrl}}" class="home-intent-card__avatar" src="{{item.avatarUrl}}" mode="aspectFill" /></view></view><view class="home-intent-card__metrics"><view class="home-intent-metric"><text>高意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.highCount}}</text></view><view class="home-intent-metric"><text>中意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.mediumCount}}</text></view><view class="home-intent-metric"><text>低意向</text><text class="home-intent-metric__value">+{{homeData.intentSummary.lowCount}}</text></view></view></view></view>
            <view class="home-section"><view class="home-section__header"><text class="home-section__title">今日数据</text></view><view class="home-today-card"><view class="home-today-card__primary"><text class="home-today-card__number">{{homeData.today.viewCount}}次</text><text class="home-today-card__label">浏览总次数</text></view><view class="home-today-card__metrics"><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.completeRate}}</text><text>总完播率</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.forwardCount}}</text><text>转发次数</text></view><view class="home-today-metric"><text class="home-today-metric__value">{{homeData.today.viewerCount}}</text><text>观看人数</text></view></view></view></view>
          </block>
        </view>
      </scroll-view>
    </swiper-item>
    <swiper-item class="home-page__tab-panel home-page__notification-panel"><notification-header embedded="{{true}}" filters="{{notifications.filters}}" active-filter="{{activeNotificationFilter}}" bind:filtertap="onNotificationFilterTap" /><scroll-view scroll-y class="home-page__tab-scroll home-page__notification-scroll"><home-notifications notifications="{{notifications}}" active-filter="{{activeNotificationFilter}}" visible-groups="{{visibleNotificationGroups}}" has-visible-groups="{{hasVisibleNotificationGroups}}" bind:cardtap="onNotificationCardTap" bind:contactaction="onNotificationContactAction" /></scroll-view></swiper-item>
    <swiper-item class="home-page__tab-panel home-page__analysis-panel"><analysis-header embedded="{{true}}" analysis-tabs="{{analysisTabs}}" active-analysis-tab="{{activeAnalysisTab}}" analysis-tab-offset="{{analysisTabOffset}}" bind:analysistabtap="onAnalysisTabTap" bind:analysistouchstart="onAnalysisTouchStart" bind:analysistouchend="onAnalysisTouchEnd" /><scroll-view scroll-y class="home-page__tab-scroll home-page__analysis-scroll"><home-analysis embedded="{{true}}" analysis-data="{{analysisData}}" analysis-periods="{{analysisPeriods}}" active-period="{{activePeriod}}" active-period-offset="{{activePeriodOffset}}" active-analysis-sort-label="{{activeAnalysisSortLabel}}" analysis-sort-options="{{analysisSortOptions}}" analysis-sort-sheet-visible="{{analysisSortSheetVisible}}" analysis-intent-tabs="{{analysisIntentTabs}}" active-analysis-intent="{{activeAnalysisIntent}}" analysis-intent-offset="{{analysisIntentOffset}}" visible-analysis-users="{{visibleAnalysisUsers}}" has-analysis-cards="{{hasAnalysisCards}}" has-analysis-users="{{hasAnalysisUsers}}" analysis-read-ranges="{{analysisReadRanges}}" active-analysis-read-range="{{activeAnalysisReadRange}}" visible-analysis-read-trend="{{visibleAnalysisReadTrend}}" bind:periodtap="onAnalysisPeriodTap" bind:analysisintenttap="onAnalysisIntentTap" bind:analysisintenttouchstart="onAnalysisIntentTouchStart" bind:analysisintenttouchend="onAnalysisIntentTouchEnd" bind:analysisrangetap="onAnalysisRangeTap" bind:analysissorttap="onAnalysisSortTap" bind:analysissortoptiontap="onAnalysisSortOptionTap" bind:analysissortmasktap="onAnalysisSortMaskTap" bind:cardtap="onAnalysisCardTap" bind:usertap="onAnalysisUserTap" /></scroll-view></swiper-item>
    <swiper-item class="home-page__tab-panel"><scroll-view scroll-y class="home-page__tab-scroll"><view class="home-profile-placeholder"><text>我的页面待设计</text></view></scroll-view></swiper-item>
  </swiper>
  <bottom-tab-bar wx:if="{{!analysisSortSheetVisible}}" items="{{tabItems}}" bind:tabtap="onTabTap" bind:plus="onPlusTap" />
</view>
