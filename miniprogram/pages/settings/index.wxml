<view class="settings-page">
  <view class="settings-page__header">
    <navigation-bar title="设置" back="{{true}}" color="#000000" background="#ffffff" />
  </view>

  <view class="settings-page__content">
    <view class="settings-card">
      <view class="settings-card__copy">
        <view class="settings-card__title-row">
          <text class="settings-card__title">推送意向门槛</text>
          <view
            class="settings-card__rules"
            bindtap="onIntentRulesTap"
            hover-class="settings-card__rules--pressed"
            hover-stay-time="100"
            aria-role="button"
            aria-label="规则"
          >
            <text class="settings-card__rules-text">规则</text>
          </view>
        </view>
        <text class="settings-card__hint">客户达到所选意向等级时，通过服务号推送提醒（需要先关注「言界阿乐」服务号）,默认高意向。</text>
      </view>
      <segmented-filter items="{{notifyIntentLevelOptions}}" active-id="{{activeNotifyIntentLevel}}" bind:change="onNotifyIntentLevelChange" />
    </view>

    <view class="settings-logout" bindtap="onLogoutTap" hover-class="settings-logout--pressed" hover-stay-time="80" aria-role="button">
      <text>退出登录</text>
    </view>
  </view>

  <view wx:if="{{intentRulesVisible}}" class="settings-rules-modal" aria-role="dialog" aria-label="意向判断标准">
    <view class="settings-rules-modal__mask" catchtap="onCloseIntentRules" catchtouchmove="onIntentRulesNoop"></view>
    <view class="settings-rules-modal__card" catchtap="onIntentRulesNoop">
      <text class="settings-rules-modal__title">{{intentRulesTitle}}</text>
      <view wx:for="{{intentRuleSections}}" wx:key="id" class="settings-rules-modal__section">
        <text class="settings-rules-modal__section-text">{{item.label}}：{{item.body}}</text>
      </view>
    </view>
  </view>
</view>
