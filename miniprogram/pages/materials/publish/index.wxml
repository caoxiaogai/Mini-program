<view class="publish-page">
  <navigation-bar back="{{true}}" color="#000000" background="#ffffff" />

  <view class="publish-page__content">
    <view class="publish-page__image-grid">
      <view
        wx:for="{{images}}"
        wx:key="id"
        class="publish-page__image-slot publish-page__image-slot--filled"
      >
        <image class="publish-page__image" src="{{item.path}}" mode="aspectFill" />
        <view
          class="publish-page__image-delete"
          data-id="{{item.id}}"
          catchtap="onDeleteImageTap"
          hover-class="publish-page__image-delete--pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="删除图片"
        >
          <image class="publish-page__image-delete-icon" src="/assets/materials/publish-delete.svg" mode="aspectFit" />
        </view>
      </view>
      <view
        wx:if="{{canAddImage}}"
        class="publish-page__image-slot publish-page__image-slot--add"
        bindtap="onAddImageTap"
        hover-class="publish-page__image-slot--pressed"
        hover-stay-time="80"
        aria-role="button"
        aria-label="添加图片"
      >
        <text class="publish-page__add-icon">+</text>
      </view>
    </view>

    <textarea
      class="publish-page__copy"
      value="{{copy}}"
      maxlength="-1"
      auto-height="true"
      placeholder="添加文案"
      placeholder-class="publish-page__copy-placeholder"
      bindinput="onCopyInput"
    />
  </view>

  <view class="publish-page__actions">
    <view class="publish-page__draft-button" bindtap="onDraftTap" hover-class="publish-page__button--pressed" hover-stay-time="80">
      <text>存草稿</text>
    </view>
    <view class="publish-page__publish-button" bindtap="onPublishTap" hover-class="publish-page__button--pressed" hover-stay-time="80">
      <text>发表</text>
    </view>
  </view>

  <view
    wx:if="{{showPublishSuccessModal}}"
    class="publish-success-modal"
    bindtap="onPublishSuccessClose"
    aria-role="dialog"
    aria-label="发布成功"
  >
    <view class="publish-success-modal__card" catchtap="onPublishSuccessCardTap">
      <view class="publish-success-modal__content">
        <view class="publish-success-modal__title-group">
          <view class="publish-success-modal__title-row">
            <text class="publish-success-modal__title">发布成功</text>
            <text class="publish-success-modal__emoji">🎉</text>
          </view>
          <text class="publish-success-modal__subtitle">快去分享给微信好友把</text>
        </view>

        <view class="publish-success-modal__share-actions">
          <view
            class="publish-success-modal__share-button publish-success-modal__share-button--secondary"
            bindtap="onShareFriendsTap"
            hover-class="publish-success-modal__share-button--pressed"
            hover-stay-time="80"
          >
            <text>分享给好友</text>
            <image class="publish-success-modal__share-icon" src="/assets/materials/detail-share.svg" mode="aspectFit" />
          </view>
          <view
            class="publish-success-modal__share-button publish-success-modal__share-button--primary"
            bindtap="onShareMomentsTap"
            hover-class="publish-success-modal__share-button--pressed"
            hover-stay-time="80"
          >
            <text>分享到朋友圈</text>
            <view class="publish-success-modal__moments-icon-wrap">
              <image class="publish-success-modal__moments-icon" src="/assets/materials/detail-moments.png" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
