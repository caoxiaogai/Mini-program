<view class="publish-page">
  <navigation-bar back="{{true}}" color="#000000" background="#f0f1f2" />

  <view class="publish-page__content">
    <view class="publish-page__image-grid">
      <view
        wx:for="{{media}}"
        wx:key="id"
        class="publish-page__image-slot publish-page__image-slot--filled"
      >
        <image
          wx:if="{{item.kind !== 'pdf'}}"
          class="publish-page__image"
          src="{{item.kind === 'video' && item.previewPath ? item.previewPath : item.path}}"
          mode="aspectFill"
        />
        <image
          wx:if="{{item.kind === 'video'}}"
          class="publish-page__video-play"
          src="/assets/materials/material-play.svg"
          mode="aspectFit"
        />
        <view wx:if="{{item.kind === 'pdf'}}" class="publish-page__pdf-slot">
          <text class="publish-page__pdf-badge">PDF</text>
          <text class="publish-page__pdf-name">{{item.name}}</text>
        </view>
        <view
          class="publish-page__image-delete"
          data-id="{{item.id}}"
          catchtap="onDeleteMediaTap"
          hover-class="publish-page__image-delete--pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="删除素材"
        >
          <image class="publish-page__image-delete-icon" src="/assets/materials/publish-delete.svg" mode="aspectFit" />
        </view>
      </view>
      <view
        wx:if="{{canAddMedia}}"
        class="publish-page__image-slot publish-page__image-slot--add"
        bindtap="onAddMediaTap"
        hover-class="publish-page__image-slot--pressed"
        hover-stay-time="80"
        aria-role="button"
        aria-label="添加素材"
      >
        <view class="publish-page__add-icon" aria-hidden="true">
          <view class="publish-page__add-icon-horizontal"></view>
          <view class="publish-page__add-icon-vertical"></view>
        </view>
      </view>
    </view>

    <view class="publish-page__copy-area" bindtap="onCopyAreaTap">
      <textarea
        class="publish-page__copy"
        value="{{copy}}"
        maxlength="-1"
        auto-height="true"
        focus="{{copyFocused}}"
        placeholder="添加文案"
        placeholder-class="publish-page__copy-placeholder"
        bindinput="onCopyInput"
        bindblur="onCopyBlur"
      />
    </view>
  </view>

  <view class="publish-page__actions">
    <view class="publish-page__draft-button" bindtap="onDraftTap" hover-class="publish-page__button--pressed" hover-stay-time="80">
      <text>存草稿</text>
    </view>
    <view class="publish-page__publish-button" bindtap="onPublishTap" hover-class="publish-page__button--pressed" hover-stay-time="80">
      <text>发表</text>
    </view>
  </view>

  <publish-type-sheet visible="{{publishTypeSheetVisible}}" bind:select="onPublishTypeSelect" bind:cancel="onPublishTypeCancel" />
  <publish-type-sheet kind="source" visible="{{publishSourceSheetVisible}}" bind:select="onPublishSourceSelect" bind:cancel="onPublishSourceCancel" />
</view>
