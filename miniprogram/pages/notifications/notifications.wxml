<view class="notification-page">
  <view class="notification-page__base"></view>
  <view class="notification-page__status-glow"></view>

  <view class="notification-page__header" style="background: rgba(232, 237, 245, {{notificationHeaderOpacity}});">
    <navigation-bar back="{{true}}" title="通知" background="transparent" />
  </view>

  <view wx:if="{{notifications}}" class="notification-page__content">
      <view class="notification-filter" role="tablist">
        <view
          wx:for="{{notifications.filters}}"
          wx:key="id"
          class="notification-filter__item {{activeFilter === item.id ? 'notification-filter__item--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilterTap"
          hover-class="notification-filter__item--pressed"
          hover-stay-time="80"
          role="tab"
          aria-selected="{{activeFilter === item.id}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{hasVisibleGroups}}">
        <view wx:for="{{visibleGroups}}" wx:key="id" class="notification-group">
          <text class="notification-group__date">{{item.label}}</text>

          <view
            wx:for="{{item.items}}"
            wx:for-item="notification"
            wx:key="id"
            class="notification-card"
            data-id="{{notification.userId}}"
            bindtap="onNotificationCardTap"
            hover-class="notification-card--pressed"
            hover-start-time="80"
            hover-stay-time="120"
          >
            <view class="notification-card__header">
              <view class="notification-card__identity">
                <view class="notification-card__avatar-wrap">
                  <image class="notification-card__avatar" src="{{notification.avatarUrl}}" mode="aspectFill" />
                  <image class="notification-card__action-icon" src="{{notification.actionIconPath}}" mode="aspectFit" />
                </view>

                <view class="notification-card__copy">
                  <view class="notification-card__name-row">
                    <text class="notification-card__name">{{notification.visitorName}}</text>
                    <text class="notification-card__intent notification-card__intent--{{notification.intent}}">{{notification.intentLabel}}</text>
                  </view>
                  <view class="notification-card__action-row">
                    <text class="notification-card__action">{{notification.actionLabel}}</text>
                    <text class="notification-card__date">{{notification.actionDate}}</text>
                  </view>
                </view>
              </view>

              <view class="notification-card__thumbnails">
                <image class="notification-card__thumbnail" src="{{notification.thumbnailUrl}}" mode="aspectFill" />
              </view>
            </view>

            <view class="notification-card__divider"></view>

            <view class="notification-card__footer">
              <text class="notification-card__recommendation">{{notification.recommendation}}</text>
              <view
                class="notification-card__contact-action-v2"
                hover-class="notification-card__contact-action-v2--pressed"
                catchtap="onContactActionTap"
                style="display:flex;align-items:center;justify-content:center;flex:none;width:128rpx;height:48rpx;margin:0;padding:0;border-radius:12rpx;background:#9d9d9d;color:#ffffff;font-size:24rpx;line-height:48rpx;"
              >联系用户</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="notification-empty-state">
        <image class="notification-empty-state__icon" src="/assets/analysis/empty-state-cloud.png" mode="aspectFill" />
        <text>暂无意向用户</text>
      </view>
  </view>
  <auth-overlay />
</view>
