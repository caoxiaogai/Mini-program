<share-gate-view wx:if="{{singlePageGateVisible}}" art-src="{{shareGateArtSrc}}" art-from-work="{{shareGateArtFromWork}}" />
<single-page-guard wx:else active="{{singlePageMode}}">
<view class="material-detail-page">
  <view class="material-detail-page__header">
    <navigation-bar title="作品" back="{{true}}" home-button="{{true}}" color="#000000" background="#ffffff" />
  </view>

  <view wx:if="{{unavailableMessage}}" class="material-detail-page__unavailable">
    <text>{{unavailableMessage}}</text>
  </view>

  <loading-skeleton wx:elif="{{!detail}}" variant="material-detail" />

  <view wx:else class="material-detail-page__content">
    <block wx:if="{{detail.fileType === 'NOTE'}}">
      <view class="note-detail">
        <block wx:for="{{detail.noteBlocks}}" wx:key="id">
          <text wx:if="{{item.type === 'text' && item.text}}" class="note-detail__text">{{item.text}}</text>

          <view
            wx:elif="{{item.type === 'location'}}"
            class="note-detail__card"
            data-latitude="{{item.latitude}}"
            data-longitude="{{item.longitude}}"
            data-name="{{item.name}}"
            data-address="{{item.address}}"
            bindtap="onNoteLocationTap"
            hover-class="note-detail__card--pressed"
            hover-stay-time="80"
          >
            <image class="note-detail__location-icon" src="/assets/materials/note-location.svg" mode="aspectFit" />
            <view class="note-detail__location-copy">
              <text class="note-detail__location-name">{{item.name}}</text>
              <text class="note-detail__location-address">{{item.address}}</text>
            </view>
          </view>

          <image
            wx:elif="{{item.type === 'image'}}"
            class="note-detail__image"
            src="{{item.path}}"
            mode="widthFix"
          />

          <view
            wx:elif="{{item.type === 'video'}}"
            class="note-detail__media"
            data-path="{{item.path}}"
            data-cover="{{item.coverPath}}"
            bindtap="onNoteVideoTap"
            hover-class="note-detail__media--pressed"
            hover-stay-time="80"
          >
            <image wx:if="{{item.coverPath}}" class="note-detail__image" src="{{item.coverPath}}" mode="widthFix" />
            <view wx:else class="note-detail__video-fallback"></view>
            <image class="note-detail__play" src="/assets/materials/material-play.svg" mode="aspectFit" />
          </view>

          <view
            wx:elif="{{item.type === 'file'}}"
            class="note-detail__card"
            data-path="{{item.path}}"
            data-name="{{item.name}}"
            bindtap="onNoteFileTap"
            hover-class="note-detail__card--pressed"
            hover-stay-time="80"
          >
            <view class="note-detail__file-badge">{{item.ext}}</view>
            <view class="note-detail__file-copy">
              <text class="note-detail__file-name">{{item.name}}</text>
              <text class="note-detail__file-meta">{{item.ext}} {{item.sizeLabel}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <block wx:elif="{{detail.fileType === 'VIDEO'}}">
      <view
        class="material-detail__media material-detail__media--video"
        bindtouchstart="onVideoTouchStart"
        bindtouchend="onVideoTouchEnd"
        bindtouchcancel="onVideoTouchEnd"
      >
        <video
          id="materialVideo"
          class="material-detail__video"
          src="{{detail.videoUrl}}"
          poster="{{detail.previewUrl}}"
          autoplay
          controls
          show-center-play-btn
          show-fullscreen-btn
          show-play-btn
          show-progress
          enable-play-gesture
          enable-progress-gesture
          object-fit="contain"
          bindplay="onVideoPlay"
          bindpause="onVideoPause"
          bindended="onVideoEnded"
          bindtimeupdate="onVideoTimeUpdate"
        />
      </view>
    </block>

    <block wx:elif="{{detail.fileType === 'PDF' || detail.fileType === 'TABLE'}}">
      <view class="material-detail__media material-detail__media--pdf" bindtap="onPdfOpenTap" hover-class="material-detail__media--pressed" hover-stay-time="80">
        <image wx:if="{{detail.previewUrl}}" class="material-detail__pdf-preview" src="{{detail.previewUrl}}" mode="aspectFit" />
        <view wx:else class="material-detail__pdf-card">
          <view class="material-detail__pdf-badge">{{detail.fileType === 'TABLE' ? '表格' : 'PDF'}}</view>
          <text class="material-detail__pdf-name">{{detail.pdfFileName}}</text>
        </view>
        <view wx:if="{{detail.fileType === 'PDF'}}" class="material-detail__pdf-fade" aria-hidden="true" />
        <view wx:if="{{detail.fileType === 'PDF'}}" class="material-detail__pdf-open">
          <view class="material-detail__pdf-open-button">
            <text>点击查看</text>
          </view>
          <text class="material-detail__pdf-open-hint">这是PDF文件，需要点击查看详情</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <swiper
        class="material-detail__swiper"
        current="{{activeImageIndex}}"
        duration="180"
        indicator-dots="{{false}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{detail.images}}" wx:key="*this">
          <image
            class="material-detail__image"
            src="{{item}}"
            mode="aspectFit"
            data-index="{{index}}"
            bindtap="onImageTap"
          />
        </swiper-item>
      </swiper>

      <view class="material-detail__indicators" aria-label="图片页码">
        <view
          wx:for="{{detail.images}}"
          wx:key="*this"
          class="material-detail__indicator {{index === activeImageIndex ? 'material-detail__indicator--active' : ''}}"
        ></view>
      </view>
    </block>

    <view wx:if="{{detail.fileType !== 'NOTE'}}" class="material-detail__description">
      <text wx:for="{{detail.descriptionLines}}" wx:key="*this" class="material-detail__description-line">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{detail}}" class="material-detail-engage {{detail.isOwner ? 'material-detail-engage--owner' : 'material-detail-engage--visitor'}}">
    <view
      wx:if="{{detail.isOwner}}"
      class="material-detail-engage__owner-actions"
      bindtap="onOwnerMoreTap"
      hover-class="material-detail-engage__action--pressed"
      hover-stay-time="80"
      aria-label="更多操作：编辑和删除作品"
    >
      <view class="material-detail-engage__owner-title">
        <image class="material-detail-engage__owner-icon" src="/assets/materials/detail-owner-more.svg" mode="aspectFit" />
        <text>更多操作</text>
      </view>
      <view class="material-detail-engage__owner-description">
        <text>编辑和删除作品</text>
        <image class="material-detail-engage__owner-chevron" src="/assets/materials/detail-owner-chevron.svg" mode="aspectFit" />
      </view>
    </view>
    <view
      wx:if="{{!detail.isOwner}}"
      class="material-detail-engage__comment-entry"
      bindtap="onCommentTap"
      hover-class="material-detail-engage__comment-entry--pressed"
      hover-stay-time="80"
      aria-label="说点什么，打开留言"
    >
      <image class="material-detail-engage__comment-entry-icon" src="/assets/materials/detail-visitor-comment-entry.svg" mode="aspectFit" />
      <text>说点什么</text>
    </view>
    <view class="material-detail-engage__actions">
      <block wx:if="{{detail.isOwner}}">
        <button
          class="material-detail-engage__action material-detail-engage__action--owner material-detail-engage__share"
          open-type="share"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="转发"
        >
          <image class="material-detail-engage__icon" src="/assets/materials/detail-forward.svg" mode="aspectFit" />
          <text class="material-detail-engage__count">{{detail.forwardCount > 0 ? detail.forwardCountLabel : '转发'}}</text>
        </button>
        <view
          class="material-detail-engage__action material-detail-engage__action--owner"
          bindtap="onLikeTap"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="点赞"
        >
          <image
            class="material-detail-engage__icon material-detail-engage__like-icon {{detail.liked ? 'material-detail-engage__like-icon--liked' : ''}}"
            src="{{detail.liked ? '/assets/materials/detail-like-filled.svg' : '/assets/materials/detail-like.svg'}}"
            mode="aspectFit"
          />
          <text class="material-detail-engage__count">{{detail.likeCount > 0 ? detail.likeCountLabel : '点赞'}}</text>
        </view>
        <view
          class="material-detail-engage__action material-detail-engage__action--owner"
          bindtap="onCommentTap"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="留言"
        >
          <image class="material-detail-engage__icon" src="/assets/materials/detail-comment.svg" mode="aspectFit" />
          <text class="material-detail-engage__count">{{detail.commentCount > 0 ? detail.commentCountLabel : '留言'}}</text>
        </view>
      </block>
      <block wx:else>
        <button
          class="material-detail-engage__action material-detail-engage__share"
          open-type="share"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="转发"
        >
          <image class="material-detail-engage__icon" src="/assets/materials/detail-forward.svg" mode="aspectFit" />
          <text class="material-detail-engage__count">{{detail.forwardCount > 0 ? detail.forwardCountLabel : '转发'}}</text>
        </button>
        <view
          class="material-detail-engage__action"
          bindtap="onLikeTap"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="点赞"
        >
          <image
            class="material-detail-engage__icon material-detail-engage__like-icon {{detail.liked ? 'material-detail-engage__like-icon--liked' : ''}}"
            src="{{detail.liked ? '/assets/materials/detail-like-filled.svg' : '/assets/materials/detail-like.svg'}}"
            mode="aspectFit"
          />
          <text class="material-detail-engage__count">{{detail.likeCount > 0 ? detail.likeCountLabel : '点赞'}}</text>
        </view>
        <view
          class="material-detail-engage__action"
          bindtap="onCommentTap"
          hover-class="material-detail-engage__action--pressed"
          hover-stay-time="80"
          aria-label="留言"
        >
          <image class="material-detail-engage__icon" src="/assets/materials/detail-comment.svg" mode="aspectFit" />
          <text class="material-detail-engage__count">{{detail.commentCount > 0 ? detail.commentCountLabel : '留言'}}</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{commentSheetVisible}}" class="material-detail-comments" catchtouchmove="onCommentSheetBlockMove">
    <view class="material-detail-comments__mask" catchtap="onCloseCommentSheet"></view>
    <view class="material-detail-comments__panel" bindtap="onCommentDismissKeyboard">
      <view class="material-detail-comments__header">
        <text class="material-detail-comments__title">评论</text>
        <view class="material-detail-comments__close" catchtap="onCloseCommentSheet" aria-label="关闭">关闭</view>
      </view>
      <scroll-view class="material-detail-comments__list" scroll-y show-scrollbar="{{false}}">
        <view class="material-detail-comments__list-inner">
          <view wx:if="{{commentsLoading}}" class="material-detail-comments__hint">加载中</view>
          <view wx:elif="{{commentsError}}" class="material-detail-comments__hint" catchtap="onRetryCommentsTap">加载失败，点击重试</view>
          <view wx:elif="{{comments.length === 0}}" class="material-detail-comments__hint">还没有评论</view>
          <block wx:else>
            <view wx:for="{{comments}}" wx:key="id" class="material-detail-comments__item">
              <image class="material-detail-comments__avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view class="material-detail-comments__body">
                <view class="material-detail-comments__meta">
                  <text class="material-detail-comments__name">{{item.nickname}}</text>
                  <text class="material-detail-comments__time">{{item.timeLabel}}</text>
                </view>
                <text class="material-detail-comments__content">{{item.content}}</text>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
      <view class="material-detail-comments__composer" catchtap="onCommentComposerTap">
        <input
          class="material-detail-comments__input"
          value="{{commentDraft}}"
          maxlength="200"
          confirm-type="send"
          adjust-position
          hold-keyboard
          placeholder="写评论…"
          bindinput="onCommentInput"
          bindconfirm="onCommentSubmit"
        />
        <view
          class="material-detail-comments__send {{commentDraft ? 'material-detail-comments__send--active' : ''}}"
          bindtap="onCommentSubmit"
        >发送</view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{detail && imagePreviewVisible}}"
    class="material-detail-preview"
    aria-role="dialog"
    aria-label="图片预览"
  >
    <swiper
      class="material-detail-preview__swiper"
      current="{{activeImageIndex}}"
      duration="180"
      disable-touch="{{previewZoomed || previewPinching}}"
      bindchange="onPreviewSwiperChange"
    >
      <swiper-item
        wx:for="{{detail.images}}"
        wx:key="*this"
        catchtouchmove="{{previewZoomed || previewPinching ? 'onPreviewBlockSwiper' : ''}}"
      >
        <movable-area class="material-detail-preview__area" scale-area>
          <movable-view
            class="material-detail-preview__view"
            direction="all"
            inertia
            out-of-bounds="{{true}}"
            scale
            scale-min="1"
            scale-max="4"
            scale-value="{{previewScale}}"
            animation="{{false}}"
            bindchange="onPreviewViewChange"
            bindscale="onPreviewScale"
            bindtouchstart="onPreviewTouchStart"
            bindtouchmove="onPreviewTouchMove"
            bindtouchend="onPreviewTouchEnd"
            bindtouchcancel="onPreviewTouchEnd"
          >
            <image
              class="material-detail-preview__image"
              src="{{item}}"
              mode="aspectFit"
              show-menu-by-longpress="{{!previewPinching}}"
            />
          </movable-view>
        </movable-area>
      </swiper-item>
    </swiper>
    <text class="material-detail-preview__counter">{{activeImageIndex + 1}} / {{detail.images.length}}</text>
  </view>

  <note-video-player
    visible="{{videoPlayerVisible}}"
    src="{{videoPlayerSrc}}"
    poster="{{videoPlayerPoster}}"
    bind:close="onCloseVideoPlayer"
  />
  <publish-success-modal
    visible="{{showPublishSuccessModal}}"
    share-ready="{{shareImageUrl ? true : false}}"
    share-image-url="{{shareImageUrl}}"
    bind:close="onPublishSuccessClose"
  />
</view>
</single-page-guard>
