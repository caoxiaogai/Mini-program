<view class="material-detail-page">
  <view class="material-detail-page__header">
    <navigation-bar title="作品" back="{{true}}" home-button="{{true}}" color="#000000" background="#f0f1f2" />
  </view>

  <view wx:if="{{unavailableMessage}}" class="material-detail-page__unavailable">
    <text>{{unavailableMessage}}</text>
  </view>

  <view wx:if="{{detail}}" class="material-detail-page__content">
    <block wx:if="{{detail.fileType === 'NOTE'}}">
      <view class="note-detail">
        <block wx:for="{{detail.noteBlocks}}" wx:key="id">
          <text wx:if="{{item.type === 'text' && item.text}}" class="note-detail__text">{{item.text}}</text>

          <view
            wx:elif="{{item.type === 'location'}}"
            class="note-detail__card"
            data-latitude="{{item.latitude}}"
            data-longitude="{{item.longitude}}"
            data-name="{{item.name}}"
            data-address="{{item.address}}"
            bindtap="onNoteLocationTap"
            hover-class="note-detail__card--pressed"
            hover-stay-time="80"
          >
            <image class="note-detail__location-icon" src="/assets/materials/note-location.svg" mode="aspectFit" />
            <view class="note-detail__location-copy">
              <text class="note-detail__location-name">{{item.name}}</text>
              <text class="note-detail__location-address">{{item.address}}</text>
            </view>
          </view>

          <image
            wx:elif="{{item.type === 'image'}}"
            class="note-detail__image"
            src="{{item.path}}"
            mode="widthFix"
          />

          <view
            wx:elif="{{item.type === 'video'}}"
            class="note-detail__media"
            data-path="{{item.path}}"
            data-cover="{{item.coverPath}}"
            bindtap="onNoteVideoTap"
            hover-class="note-detail__media--pressed"
            hover-stay-time="80"
          >
            <image wx:if="{{item.coverPath}}" class="note-detail__image" src="{{item.coverPath}}" mode="widthFix" />
            <view wx:else class="note-detail__video-fallback"></view>
            <image class="note-detail__play" src="/assets/materials/material-play.svg" mode="aspectFit" />
          </view>

          <view
            wx:elif="{{item.type === 'file'}}"
            class="note-detail__card"
            data-path="{{item.path}}"
            data-name="{{item.name}}"
            bindtap="onNoteFileTap"
            hover-class="note-detail__card--pressed"
            hover-stay-time="80"
          >
            <view class="note-detail__file-badge">{{item.ext}}</view>
            <view class="note-detail__file-copy">
              <text class="note-detail__file-name">{{item.name}}</text>
              <text class="note-detail__file-meta">{{item.ext}} {{item.sizeLabel}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <block wx:elif="{{detail.fileType === 'VIDEO'}}">
      <view
        class="material-detail__media material-detail__media--video"
        bindtouchstart="onVideoTouchStart"
        bindtouchend="onVideoTouchEnd"
        bindtouchcancel="onVideoTouchEnd"
      >
        <video
          id="materialVideo"
          class="material-detail__video"
          src="{{detail.videoUrl}}"
          poster="{{detail.previewUrl}}"
          autoplay
          controls
          show-center-play-btn
          show-fullscreen-btn
          show-play-btn
          show-progress
          enable-play-gesture
          enable-progress-gesture
          object-fit="contain"
          bindplay="onVideoPlay"
          bindpause="onVideoPause"
          bindended="onVideoEnded"
          bindtimeupdate="onVideoTimeUpdate"
        />
      </view>
    </block>

    <block wx:elif="{{detail.fileType === 'PDF' || detail.fileType === 'TABLE'}}">
      <view class="material-detail__media material-detail__media--pdf" bindtap="onPdfOpenTap" hover-class="material-detail__media--pressed" hover-stay-time="80">
        <image wx:if="{{detail.previewUrl}}" class="material-detail__pdf-preview" src="{{detail.previewUrl}}" mode="aspectFit" />
        <view wx:else class="material-detail__pdf-card">
          <view class="material-detail__pdf-badge">{{detail.fileType === 'TABLE' ? '表格' : 'PDF'}}</view>
          <text class="material-detail__pdf-name">{{detail.pdfFileName}}</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <swiper
        class="material-detail__swiper"
        current="{{activeImageIndex}}"
        duration="180"
        indicator-dots="{{false}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{detail.images}}" wx:key="*this">
          <image
            class="material-detail__image"
            src="{{item}}"
            mode="aspectFit"
            data-index="{{index}}"
            bindtap="onImageTap"
          />
        </swiper-item>
      </swiper>

      <view class="material-detail__indicators" aria-label="图片页码">
        <view
          wx:for="{{detail.images}}"
          wx:key="*this"
          class="material-detail__indicator {{index === activeImageIndex ? 'material-detail__indicator--active' : ''}}"
        ></view>
      </view>
    </block>

    <view wx:if="{{detail.fileType !== 'NOTE'}}" class="material-detail__description">
      <text wx:for="{{detail.descriptionLines}}" wx:key="*this" class="material-detail__description-line">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{detail}}" class="material-detail__share-bar">
    <button class="material-detail__share-button material-detail__share-button--friend" open-type="share" hover-class="material-detail__share-button--pressed" hover-stay-time="80">
      <text>分享给好友</text>
      <image class="material-detail__share-icon" src="/assets/materials/detail-share.svg" mode="aspectFit" />
    </button>
    <button
      wx:if="{{detail.isOwner}}"
      class="material-detail__share-button material-detail__share-button--edit"
      bindtap="onSecondaryEditTap"
      hover-class="material-detail__share-button--pressed"
      hover-stay-time="80"
    >
      <text>二次编辑</text>
      <image class="material-detail__share-icon" src="/assets/materials/detail-edit.svg" mode="aspectFit" />
    </button>
    <button
      wx:else
      class="material-detail__share-button material-detail__share-button--moments"
      bindtap="onShareMomentsTap"
      hover-class="material-detail__share-button--pressed"
      hover-stay-time="80"
    >
      <text>分享到朋友圈</text>
      <view class="material-detail__moments-icon">
        <image src="/assets/materials/detail-moments.png" mode="aspectFit" />
      </view>
    </button>
  </view>

  <view
    wx:if="{{detail && imagePreviewVisible}}"
    class="material-detail-preview"
    aria-role="dialog"
    aria-label="图片预览"
  >
    <swiper
      class="material-detail-preview__swiper"
      current="{{activeImageIndex}}"
      duration="180"
      disable-touch="{{previewZoomed || previewPinching}}"
      bindchange="onPreviewSwiperChange"
    >
      <swiper-item
        wx:for="{{detail.images}}"
        wx:key="*this"
        catchtouchmove="{{previewZoomed || previewPinching ? 'onPreviewBlockSwiper' : ''}}"
      >
        <movable-area class="material-detail-preview__area" scale-area>
          <movable-view
            class="material-detail-preview__view"
            direction="all"
            inertia
            out-of-bounds="{{true}}"
            scale
            scale-min="1"
            scale-max="4"
            scale-value="{{previewScale}}"
            animation="{{false}}"
            bindchange="onPreviewViewChange"
            bindscale="onPreviewScale"
            bindtouchstart="onPreviewTouchStart"
            bindtouchmove="onPreviewTouchMove"
            bindtouchend="onPreviewTouchEnd"
            bindtouchcancel="onPreviewTouchEnd"
          >
            <image
              class="material-detail-preview__image"
              src="{{item}}"
              mode="aspectFit"
              show-menu-by-longpress="{{!previewPinching}}"
            />
          </movable-view>
        </movable-area>
      </swiper-item>
    </swiper>
    <text class="material-detail-preview__counter">{{activeImageIndex + 1}} / {{detail.images.length}}</text>
  </view>

  <note-video-player
    visible="{{videoPlayerVisible}}"
    src="{{videoPlayerSrc}}"
    poster="{{videoPlayerPoster}}"
    bind:close="onCloseVideoPlayer"
  />
</view>
