<view wx:if="{{ready}}" class="auth-page">
  <view class="auth-page__header">
    <navigation-bar title="" back="{{true}}" color="#000000" background="#ffffff" />
  </view>

  <form bindsubmit="onFormSubmit">
    <view class="auth-page__content" style="min-height: calc(100vh - {{navigationHeight}}px);">
      <view class="auth-page__copy">
        <text class="auth-page__title">微信授权</text>
        <text class="auth-page__hint">{{hasAvatar ? '点键盘上方的微信昵称，完成后自动授权' : '点击下方按钮，选择微信头像'}}</text>
      </view>

      <button class="auth-page__avatar-button" open-type="chooseAvatar" hover-class="auth-page__avatar-button--pressed" disabled="{{busy}}" bind:chooseavatar="onChooseAvatar">
        <image class="auth-page__avatar" src="{{avatarFilePath || avatarUrl !== defaultAvatarUrl ? avatarUrl : '/assets/auth/avatar-placeholder.svg'}}" mode="aspectFill" />
      </button>

      <input
        wx:if="{{nickname}}"
        id="auth-nickname"
        class="auth-page__nickname"
        type="nickname"
        name="nickname"
        maxlength="20"
        placeholder="使用微信昵称"
        placeholder-class="auth-page__placeholder"
        disabled="{{busy}}"
        value="{{nickname}}"
        focus="{{nicknameFocused}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onNicknameChange"
        bindchange="onNicknameChange"
        bindblur="onNicknameBlur"
        bindnicknamereview="onNicknameReview"
      />
      <input
        wx:else
        id="auth-nickname"
        class="auth-page__nickname"
        type="nickname"
        name="nickname"
        maxlength="20"
        placeholder="使用微信昵称"
        placeholder-class="auth-page__placeholder"
        disabled="{{busy}}"
        focus="{{nicknameFocused}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onNicknameChange"
        bindchange="onNicknameChange"
        bindblur="onNicknameBlur"
        bindnicknamereview="onNicknameReview"
      />

      <button
        wx:if="{{!hasAvatar}}"
        class="auth-page__primary"
        open-type="chooseAvatar"
        hover-class="auth-page__primary--pressed"
        disabled="{{busy}}"
        bind:chooseavatar="onChooseAvatar"
      >使用微信一键授权</button>
      <button
        wx:elif="{{busy}}"
        class="auth-page__primary"
        loading="{{true}}"
        disabled="{{true}}"
      >正在授权</button>
      <button
        wx:elif="{{loginFailed}}"
        class="auth-page__primary"
        hover-class="auth-page__primary--pressed"
        bindtap="onRetryLogin"
      >重试授权</button>
    </view>
  </form>
</view>
