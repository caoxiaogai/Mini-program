<view class="auth-page">
  <view class="auth-page__header">
    <navigation-bar title="授权" back="{{false}}" color="#000000" background="#ffffff" />
  </view>

  <form class="auth-page__content" bindsubmit="onFormSubmit">
    

    <button class="auth-page__avatar-button" open-type="chooseAvatar" hover-class="auth-page__avatar-button--pressed" disabled="{{busy}}" bind:chooseavatar="onChooseAvatar">
      <image class="auth-page__avatar" src="{{avatarUrl}}" mode="aspectFill" />
    </button>

    <input
      wx:if="{{nickname}}"
      id="auth-nickname"
      class="auth-page__nickname"
      type="nickname"
      name="nickname"
      maxlength="10"
      placeholder="请输入昵称"
      value="{{nickname}}"
      focus="{{nicknameFocused}}"
      bindchange="onNicknameChange"
      bindblur="onNicknameBlur"
      bindnicknamereview="onNicknameReview"
    />
    <input
      wx:else
      id="auth-nickname"
      class="auth-page__nickname"
      type="nickname"
      name="nickname"
      maxlength="10"
      placeholder="请输入昵称"
      focus="{{nicknameFocused}}"
      bindchange="onNicknameChange"
      bindblur="onNicknameBlur"
      bindnicknamereview="onNicknameReview"
    />

    <button class="auth-page__wechat" open-type="chooseAvatar" hover-class="auth-page__wechat--pressed" disabled="{{busy}}" bind:chooseavatar="onChooseAvatar">用微信头像和昵称</button>

    <button class="auth-page__primary" form-type="submit" hover-class="auth-page__primary--pressed" disabled="{{busy}}">授权查看</button>
  </form>
</view>
